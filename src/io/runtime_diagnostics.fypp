#include "build_options.h"
#:include "stencil_macros.fypph"

! Runtime diagnostics and periodic field output.
!
! Once per step: reduce the CFL number across ranks and adapt the timestep,
! take the wall gradients of the mean profiles, write the Runtimedata lines,
! and save a restart or a numbered field when the configured intervals are
! crossed.
module runtime_diagnostics

  use, intrinsic :: iso_c_binding
  use channel_grid
  use channel_state
  use stencil_coefficients
  use mpi_transpose
  use restart_io, only: restart_write
  use roctx, only: roctxPush, roctxPop

  implicit none

  public :: outstats

contains

  ! Plane variance of one component on one wall plane: <phi'^2>_{x,z} there.
  !
  ! Identically zero under a Dirichlet wall -- every mode but the mean is held at
  ! zero -- and the headline H2 quantity under a Neumann one, where the wall
  ! temperature fluctuates.  It is also the cleanest settling signal an isoflux
  ! run has: a run started from an isothermal field begins at *exactly* zero and
  ! has to build the wall fluctuation up to a plateau, so unlike the mean profile
  ! (which starts near equilibrium when g is chosen from the isothermal run)
  ! there is no ambiguity between a residual transient and sampling noise.
  !
  ! Parseval, in the solver's own convention: the stored (0,0) coefficient is the
  ! plane average -- outstats and yintegr use it as such -- so the coefficients
  ! are the amplitudes of exp(i(alpha*x + beta*z)) and the plane variance is the
  ! sum of their squared moduli over every mode but that one.  Only kx >= 0 is
  ! stored, so a mode with kx > 0 counts twice, once for its conjugate at -kx;
  ! the kx = 0 row holds both signs of kz explicitly and counts once.
  real(C_DOUBLE) function wall_plane_variance(component, iy)
    IMPLICIT NONE
    integer(C_INT), intent(in) :: component, iy
    real(C_DOUBLE) :: acc
    integer(C_INT) :: ix, iz, weight

    acc = 0.0d0
    !$omp target teams distribute parallel do collapse(2) reduction(+: acc) &
    !$omp shared(V, nx0, nxN, nz, component, iy) private(ix, iz, weight)
    do ix = nx0, nxN
      do iz = -nz, nz
        if (ix == 0 .and. iz == 0) then
          weight = 0                      ! the mean mode is not a fluctuation
        else if (ix == 0) then
          weight = 1
        else
          weight = 2
        end if
        acc = acc + weight*(dreal(V(iy, iz, ix, component))**2 + dimag(V(iy, iz, ix, component))**2)
      end do
    end do
    wall_plane_variance = acc
  end function wall_plane_variance

  SUBROUTINE outstats()
    IMPLICIT NONE
    real(C_DOUBLE) :: runtime_global, dudy(1:2 + nPhi, 1:2)   !cfl
    ! Mean scalar value *at* each wall, (iPhi, lower/upper).  Under Dirichlet it
    ! is whatever the deck set and the wall gradient is the result; under
    ! Neumann the roles swap -- the gradient columns are constants, and this is
    ! the quantity that moves, and that gives Nu and the wall-to-bulk
    ! difference.  So both are written, whatever the condition.
    real(C_DOUBLE) :: phi_wall(1:nPhi, 1:2)
    ! Plane variance of the wall temperature, (iPhi, lower/upper).  Zero under
    ! Dirichlet by construction; under Neumann it is the H2 signature and the
    ! settling monitor -- see wall_plane_variance above.
    real(C_DOUBLE) :: phi_wall_var(1:nPhi, 1:2)
    character(len=40) :: istring, filename
    integer :: iPhi
    complex(C_DOUBLE_COMPLEX) :: mean_line_u(-1:ny + 1), mean_line_w(-1:ny + 1), mean_line_scalar(-1:ny + 1)

    if (has_average) then
      !$omp target update from(V(ny0 - 2:nyN + 2, 0, 0, 1))
      !$omp target update from(V(ny0 - 2:nyN + 2, 0, 0, 3))
      call gather_full_y_line(ny, V(:, 0, 0, 1), mean_line_u)
      call gather_full_y_line(ny, V(:, 0, 0, 3), mean_line_w)
    end if
    call roctxPush("MPI_Allreduce outstats_cfl")
    CALL MPI_Allreduce(cfl, runtime_global, 1, MPI_DOUBLE_PRECISION, MPI_MAX, MPI_COMM_WORLD); cfl = 0; 
    call roctxPop("MPI_Allreduce outstats_cfl")
    IF (cflmax > 0) deltat = cflmax/runtime_global
    IF (has_average) THEN
      dudy(1, 2) = -${at_upper_wall_real('d14n', 'mean_line_u')}$
      dudy(2, 2) = -${at_upper_wall_real('d14n', 'mean_line_w')}$
      DO iPhi = 1, nPhi
        !$omp target update from(V(ny0 - 2:nyN + 2, 0, 0, 3 + iPhi))
        call gather_full_y_line(ny, V(:, 0, 0, 3 + iPhi), mean_line_scalar)
        dudy(2 + iPhi, 2) = ${at_upper_wall_real('d14n', 'mean_line_scalar')}$
        dudy(2 + iPhi, 1) = ${at_lower_wall_real('d140', 'mean_line_scalar')}$
        ! The wall planes themselves: solve_wall_normal_component reconstructs
        ! phi(0) and phi(ny) after every solve, so these are the solution there
        ! and not an extrapolation.
        phi_wall(iPhi, 1) = dreal(mean_line_scalar(0))
        phi_wall(iPhi, 2) = dreal(mean_line_scalar(ny))
      END DO
      dudy(1, 1) = ${at_lower_wall_real('d140', 'mean_line_u')}$
      dudy(2, 1) = ${at_lower_wall_real('d140', 'mean_line_w')}$
    END IF
    ! The wall planes live on the ranks owning the first and last interior slab
    ! (ny0 == 1, nyN == ny-1), and are spread over every rank in xz, so every
    ! rank contributes its own modes or nothing and one reduction collects them.
    phi_wall_var = 0.0d0
    DO iPhi = 1, nPhi
      IF (ny0 == 1) phi_wall_var(iPhi, 1) = wall_plane_variance(3 + iPhi, 0)
      IF (nyN == ny - 1) phi_wall_var(iPhi, 2) = wall_plane_variance(3 + iPhi, ny)
    END DO
    IF (nPhi > 0) THEN
      call roctxPush("MPI_Allreduce outstats_wall_var")
      CALL MPI_Allreduce(MPI_IN_PLACE, phi_wall_var, 2*nPhi, MPI_DOUBLE_PRECISION, MPI_SUM, MPI_COMM_WORLD, ierr)
      call roctxPop("MPI_Allreduce outstats_wall_var")
    END IF
    IF (has_terminal) THEN
      !$omp target update from(fr)
      WRITE (*, "(F10.4,3X,4(F11.6,3X),4(F9.4,3X),2(F9.6,3X))") &
           time,dudy(1,1),dudy(1,2),dudy(2,1),dudy(2,2),fr(1)+corrpx*fr(3),meanpx+corrpx,fr(2)+corrpz*fr(3),meanpz+corrpz,runtime_global*deltat,deltat
      WRITE(121,*) time,dudy(1,1),dudy(1,2),dudy(2,1),dudy(2,2),fr(1)+corrpx*fr(3),meanpx+corrpx,fr(2)+corrpz*fr(3),meanpz+corrpz,runtime_global*deltat,deltat
      ! Runtimedata.phi, nPhi columns per group:
      !   time | dphi/dy at y0 | dphi/dy at yN | INT(phi) dy | corrtx + meantx
      !        | <phi> at y0   | <phi> at yN
      !        | <phi'^2> at y0 | <phi'^2> at yN
      ! Groups are appended rather than inserted, so a reader written against an
      ! older file keeps working.
      WRITE (195, *) time, dudy(3:, 1), dudy(3:, 2), fr(4:3 + nPhi) + corrtx(:)*fr(3 + nPhi + 1:3 + 2*nPhi), &
        corrtx + meantx, phi_wall(:, 1), phi_wall(:, 2), phi_wall_var(:, 1), phi_wall_var(:, 2)
      FLUSH (121); FLUSH (195)
    END IF
    runtime_global = 0
    !Save Dati.cart.out
    IF (.not. disable_restart_write .and. &
        (((FLOOR((time + 0.5*deltat)/dt_save) > FLOOR((time - 0.5*deltat)/dt_save)) .AND. (istep > 1)) .OR. istep == nstep)) THEN
      IF (has_terminal) WRITE (*, *) "Writing Dati.cart.out at time ", time
      filename = "Dati.cart.out"
      !$omp target update from(V)
      call restart_write(filename, V, ni, time)
    END IF
    !Save Dati.cart.i.out
    IF ((FLOOR((time + 0.5*deltat)/dt_field) > FLOOR((time - 0.5*deltat)/dt_field)) .AND. (istep > 1)) THEN
      ifield = ifield + 1; WRITE (istring, *) ifield
      IF (has_terminal) WRITE (*, *) "Writing Dati.cart."//TRIM(ADJUSTL(istring))//".out at time ", time
      filename = "Dati.cart."//TRIM(ADJUSTL(istring))//".out"
      !$omp target update from(V)
      call restart_write(filename, V, ni, time)
    END IF

  END SUBROUTINE outstats

end module runtime_diagnostics
