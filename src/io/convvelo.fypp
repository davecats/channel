#include "build_options.h"
#:include "convvelo_fields.fypph"

module convvelo

  use, intrinsic :: iso_c_binding
  use config, only: ini_config, has_section, get_string, get_real, get_logical
  use case_setup, only: V, nPhi, nz, ny, nxd, izd, factor, &
                     apply_dy, apply_d2y, has_terminal, &
                     time, deltat, overlapping
  use pressure_output, only: compute_poisson, compute_dpdy
  use channel_grid, only: ny0, nyN, nx0, nxN, nxB, nzB, has_average, nzd
  use channel_transforms, only: spectral_field_to_real_x, real_x_to_spectral_field
  use convvelo_io, only: write_convvelo_raw_file, write_convvelo_layout_file, average_convvelo_field, &
                         average_convvelo_direct_field, write_convvelo_timing_file
  use ffts, only: VVdz
#if defined(HAVE_CUDA) || defined(HAVE_HIP)
  use ffts, only: get_fft_workspace_bytes, get_fft_workspace_bytes_for_dims, &
                  bind_fft_workspace, unbind_fft_workspace
#endif
  use byte_workspace, only: workspace_request, workspace_release, workspace_align_offset, &
                            workspace_layout, layout_begin, layout_bytes, layout_real_3d
  use env_options, only: lowercase

  implicit none

  private

  integer(C_INT), parameter :: n_convvelo_velocity_fields_total = ${len(CONVVELO_VELOCITY_FIELDS)}$
  integer(C_INT), parameter :: n_convvelo_scalar_fields_total = ${len(CONVVELO_SCALAR_FIELDS)}$
  integer(C_INT), parameter :: n_convvelo_velocity_fields_minimal_total = ${len(CONVVELO_MINIMAL_VELOCITY_FIELDS)}$
  integer(C_INT), parameter :: n_convvelo_scalar_fields_minimal_total = ${len(CONVVELO_MINIMAL_SCALAR_FIELDS)}$
  integer(C_INT), parameter :: n_convvelo_profile_fields = ${len(CONVVELO_PROFILE_FIELDS)}$
  integer(C_INT), parameter :: i_u = 1
  integer(C_INT), parameter :: i_v = 2
  integer(C_INT), parameter :: i_w = 3
  character(len=*), parameter :: convvelo_runtime_filename = "convvelo.bin"

  ! The catalogue lives in convvelo_fields.fypph.  The name arrays below feed
  ! the .fields layout file; the iv_/is_ constants name the same fields for
  ! acc_convvelo_stats, which used to look each one up by string at runtime.
  $:convvelo_name_array('velocity_field_names', CONVVELO_VELOCITY_FIELDS)
  $:convvelo_name_array('scalar_field_names', CONVVELO_SCALAR_FIELDS)
  $:convvelo_name_array('convvelo_profile_field_names', CONVVELO_PROFILE_FIELDS, width=16)
  $:convvelo_field_ids('iv_', CONVVELO_VELOCITY_FIELDS)
  $:convvelo_field_ids('is_', CONVVELO_SCALAR_FIELDS)
  $:convvelo_subset_ids('minimal_velocity_field_ids', CONVVELO_MINIMAL_VELOCITY_FIELDS, CONVVELO_VELOCITY_FIELDS)
  $:convvelo_subset_ids('minimal_scalar_field_ids', CONVVELO_MINIMAL_SCALAR_FIELDS, CONVVELO_SCALAR_FIELDS)
  $:convvelo_subset_ids('direct_velocity_field_ids', CONVVELO_DIRECT_VELOCITY_FIELDS, CONVVELO_VELOCITY_FIELDS)
  $:convvelo_subset_ids('direct_scalar_field_ids', CONVVELO_DIRECT_SCALAR_FIELDS, CONVVELO_SCALAR_FIELDS)
  $:convvelo_subset_ids('dt_velocity_field_ids', CONVVELO_DT_VELOCITY_FIELDS, CONVVELO_VELOCITY_FIELDS)
  $:convvelo_subset_ids('dt_scalar_field_ids', CONVVELO_DT_SCALAR_FIELDS, CONVVELO_SCALAR_FIELDS)

  ! The direct convection velocity walks a three-step burst around each
  ! dt_compute trigger: the trigger step becomes n-1, so the sample centres one
  ! deltat later than the nominal trigger time.
  integer(C_INT), parameter :: cvv_idle = 0_C_INT
  integer(C_INT), parameter :: cvv_armed = 1_C_INT
  integer(C_INT), parameter :: cvv_middle = 2_C_INT

  logical, save :: convvelo_initialized = .false.
  logical, save :: convvelo_dirty = .false.
  logical, save, public :: convvelo_enabled = .false.
  logical, save :: convvelo_write_full_fields = .true.
  integer(C_INT), save, public :: n_convvelo_velocity_fields = 0
  integer(C_INT), save, public :: n_convvelo_scalar_fields = 0
  integer(C_INT), save, public :: n_convvelo_fields = 0
  integer(C_INT64_T), save :: convvelo_last_write_index = -1_C_INT64_T
  real(C_DOUBLE), save :: convvelo_t_start = 0.0d0
  real(C_DOUBLE), save :: convvelo_dt_compute = -1.0d0
  real(C_DOUBLE), save :: convvelo_dt_write = -1.0d0
  real(C_DOUBLE), save :: convvelo_average_start_time = 0.0d0
  real(C_DOUBLE), save :: convvelo_average_end_time = 0.0d0
  character(len=16), save :: convvelo_output_mode = "full"
  integer(C_INT), allocatable, save :: convvelo_velocity_field_ids(:)
  integer(C_INT), allocatable, save :: convvelo_scalar_field_ids(:)
  integer(C_INT), allocatable, save :: convvelo_field_map(:)
  integer(C_INT64_T), save :: n_mean_samples = 0_C_INT64_T

  ! Direct mode.  convvelo_output_source(i) says where output field i lives:
  ! a positive value is a slot in convvelo_stats, a negative one is minus a slot
  ! in convvelo_direct.  The two arrays are disjoint, which is the whole point --
  ! only the imaginary part of <u* du/dt> is kept, so it is stored real.
  logical, save, public :: convvelo_direct_enabled = .false.
  integer(C_INT), save :: n_convvelo_stats_fields = 0_C_INT
  integer(C_INT), save :: n_convvelo_direct_fields = 0_C_INT
  integer(C_INT), allocatable, save :: convvelo_output_source(:)
  integer(C_INT), allocatable, save, public :: convvelo_direct_output(:)
  integer(C_INT), save :: convvelo_direct_state = cvv_idle
  real(C_DOUBLE), save :: convvelo_t1 = 0.0d0, convvelo_t2 = 0.0d0
  logical, save :: convvelo_write_pending = .false.
  integer(C_INT64_T), save :: convvelo_n_triplets = 0_C_INT64_T
  integer(C_INT64_T), save :: convvelo_n_dropped = 0_C_INT64_T
  real(C_DOUBLE), save :: convvelo_sum_h1 = 0.0d0, convvelo_sum_h2 = 0.0d0
  real(C_DOUBLE), save :: convvelo_min_h = 0.0d0, convvelo_max_h = 0.0d0
  real(C_DOUBLE), allocatable, save :: convvelo_energy_rate(:)

  complex(C_DOUBLE_COMPLEX), allocatable, save, public :: convvelo_stats(:, :, :, :)
  complex(C_DOUBLE_COMPLEX), allocatable, save, public :: convvelo_work(:, :, :)
  complex(C_DOUBLE_COMPLEX), allocatable, save, public :: component_means(:, :)
  complex(C_DOUBLE_COMPLEX), allocatable, save, public :: convvelo_prev1(:, :, :, :)
  complex(C_DOUBLE_COMPLEX), allocatable, save, public :: convvelo_prev2(:, :, :, :)
  real(C_DOUBLE), allocatable, save, public :: convvelo_direct(:, :, :, :)
  real(C_DOUBLE), pointer, contiguous, save :: convvelo_real0(:, :, :) => null()
  real(C_DOUBLE), pointer, contiguous, save :: convvelo_real1(:, :, :) => null()
  real(C_DOUBLE), pointer, contiguous, save :: convvelo_real_prod(:, :, :) => null()
  integer(C_INT64_T), allocatable, save :: n_field_samples(:)

  public :: init_convvelo, reset_convvelo_stats, update_convvelo_component_means, free_convvelo
  public :: finish_convvelo_field
  public :: acc_convvelo_stats, convvelo_has_pending_output
  public :: init_convvelo_runtime, advance_convvelo_runtime, finalize_convvelo_runtime
  public :: get_convvelo_memory_estimate, get_convvelo_workspace_estimate, write_convvelo_raw_stats, write_convvelo_runtime_snapshot
  public :: configure_convvelo
  public :: copy_convvelo_field_average
  public :: fill_convvelo_synthetic_state_for_test
  ! Exposed so test_convvelo_direct can drive the three-level estimator with a
  ! field whose exact answer is known, without a time loop.
  public :: save_convvelo_time_level, accumulate_direct_numerator, convvelo_direct_output

contains

  subroutine configure_convvelo(cfg)
    implicit none
    type(ini_config), intent(in) :: cfg
    logical :: found
    character(len=16) :: convvelo_mode

    convvelo_enabled = .false.
    convvelo_write_full_fields = .true.
    convvelo_direct_enabled = .false.
    convvelo_t_start = time
    convvelo_dt_compute = -1.0d0
    convvelo_dt_write = -1.0d0
    convvelo_output_mode = "full"
    convvelo_average_start_time = 0.0d0
    convvelo_average_end_time = 0.0d0

    convvelo_enabled = has_section(cfg, "convvelo")

    if (.not. convvelo_enabled) return

    convvelo_mode = convvelo_output_mode
    call get_string(cfg, "convvelo", "output_mode", convvelo_mode, found)
    if (found) convvelo_output_mode = trim(convvelo_mode)
    call get_logical(cfg, "convvelo", "direct", convvelo_direct_enabled, found)
    call get_real(cfg, "convvelo", "t_start", convvelo_t_start, found)
    call get_real(cfg, "convvelo", "dt_compute", convvelo_dt_compute, found)
    call get_real(cfg, "convvelo", "dt_write", convvelo_dt_write, found)

    select case (lowercase(adjustl(trim(convvelo_output_mode))))
    case ("full")
      convvelo_write_full_fields = .true.
      convvelo_output_mode = "full"
    case ("minimal")
      convvelo_write_full_fields = .false.
      convvelo_output_mode = "minimal"
    case ("none")
      convvelo_write_full_fields = .false.
      convvelo_output_mode = "none"
    case default
      error stop "configure_convvelo: convvelo_output_mode must be 'full', 'minimal' or 'none'"
    end select

    if (convvelo_output_mode == "none" .and. .not. convvelo_direct_enabled) then
      error stop "configure_convvelo: output_mode = 'none' asks for no fields; set direct = true or pick another mode"
    end if

    if (convvelo_dt_compute <= 0.0d0) then
      error stop "configure_convvelo: convvelo_dt_compute must be > 0 when convection velocity output is enabled"
    end if

    ! The memory estimate runs before init_convvelo, and needs the field counts.
    call init_convvelo_field_layout()

  end subroutine configure_convvelo

  subroutine get_convvelo_memory_estimate(n_floats)
    implicit none
    integer(C_INT64_T), intent(out) :: n_floats
    integer(C_INT64_T) :: local_y, spectral_planes, component_planes, n_fields

    if (.not. convvelo_enabled) then
      n_floats = 0_C_INT64_T
      return
    end if

    local_y = int(nyN - ny0 + 5, C_INT64_T)
    spectral_planes = local_y*int(2*nz + 1, C_INT64_T)*int(nxN - nx0 + 1, C_INT64_T)
    component_planes = local_y*int(3 + nPhi, C_INT64_T)
    ! configure_convvelo has already run the layout, so these are the counts
    ! this run will actually allocate rather than a worst case.
    n_fields = int(n_convvelo_stats_fields, C_INT64_T)

    n_floats = 0_C_INT64_T
    n_floats = n_floats + 2_C_INT64_T*spectral_planes*n_fields
    n_floats = n_floats + 2_C_INT64_T*spectral_planes
    n_floats = n_floats + 2_C_INT64_T*component_planes
    if (convvelo_direct_enabled) then
      ! One real plane per component for the numerator, two complex time levels.
      n_floats = n_floats + spectral_planes*int(3 + nPhi, C_INT64_T)
      n_floats = n_floats + 4_C_INT64_T*spectral_planes*int(3 + nPhi, C_INT64_T)
    end if
  end subroutine get_convvelo_memory_estimate

  subroutine get_convvelo_workspace_estimate(nbytes)
    implicit none
    integer(C_SIZE_T), intent(out) :: nbytes
    integer(C_SIZE_T) :: real_bytes
#if defined(HAVE_CUDA) || defined(HAVE_HIP)
    integer(C_SIZE_T) :: fft_offset, fft_bytes
#endif

    if (.not. convvelo_enabled) then
      nbytes = 0_C_SIZE_T
      return
    end if

    call get_convvelo_local_real_workspace_bytes(real_bytes)
#if defined(HAVE_CUDA) || defined(HAVE_HIP)
    call get_fft_workspace_bytes_for_dims(nxd, nxB, nzd, nzB, nPhi, overlapping, fft_bytes)
    fft_offset = workspace_align_offset(real_bytes)
    nbytes = workspace_align_offset(fft_offset + fft_bytes)
#else
    nbytes = real_bytes
#endif
  end subroutine get_convvelo_workspace_estimate

  subroutine init_convvelo()
    implicit none

    if (convvelo_initialized) return

    call init_convvelo_field_layout()

    allocate (convvelo_stats(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN, max(n_convvelo_stats_fields, 1)))
    allocate (convvelo_work(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN))
    allocate (component_means(ny0 - 2:nyN + 2, 1:3 + nPhi))
    nullify (convvelo_real0, convvelo_real1, convvelo_real_prod)
    allocate (n_field_samples(n_convvelo_fields))

    convvelo_stats = (0.0d0, 0.0d0)
    convvelo_work = (0.0d0, 0.0d0)
    component_means = (0.0d0, 0.0d0)
    n_field_samples = 0_C_INT64_T

    !$omp target enter data map(to: convvelo_stats, convvelo_work, component_means)

    if (convvelo_direct_enabled) then
      allocate (convvelo_direct(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN, 1:3 + nPhi))
      allocate (convvelo_prev1(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN, 1:3 + nPhi))
      allocate (convvelo_prev2(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN, 1:3 + nPhi))
      allocate (convvelo_energy_rate(3 + nPhi))
      convvelo_direct = 0.0d0
      convvelo_prev1 = (0.0d0, 0.0d0)
      convvelo_prev2 = (0.0d0, 0.0d0)
      convvelo_energy_rate = 0.0d0
      !$omp target enter data map(to: convvelo_direct, convvelo_prev1, convvelo_prev2)
    end if

    n_mean_samples = 0_C_INT64_T
    convvelo_last_write_index = -1_C_INT64_T
    convvelo_average_start_time = 0.0d0
    convvelo_average_end_time = 0.0d0
    convvelo_dirty = .false.
    convvelo_initialized = .true.
  end subroutine init_convvelo

  ! Decides which catalogue entries this run stores, in file order, and where
  ! each one lives.  output_mode picks the reconstruction set; direct = true
  ! unions in the numerator fields and the energies they are divided by.  The
  ! dt fields are never part of full or minimal: they are accumulated from three
  ! time levels rather than by acc_convvelo_stats, and they are stored real.
  subroutine init_convvelo_field_layout()
    implicit none
    integer(C_INT) :: i, iPhi, raw_field_index, out_index, stats_slot, component
    integer(C_INT) :: vel_ids(n_convvelo_velocity_fields_total)
    integer(C_INT) :: scal_ids(n_convvelo_scalar_fields_total)
    integer(C_INT) :: n_vel, n_scal

    if (allocated(convvelo_velocity_field_ids)) deallocate (convvelo_velocity_field_ids)
    if (allocated(convvelo_scalar_field_ids)) deallocate (convvelo_scalar_field_ids)
    if (allocated(convvelo_field_map)) deallocate (convvelo_field_map)
    if (allocated(convvelo_output_source)) deallocate (convvelo_output_source)
    if (allocated(convvelo_direct_output)) deallocate (convvelo_direct_output)

    ! Order is the file order, and it is load-bearing: the reference data and the
    ! post-processing tools read fields positionally.  Build the list by walking
    ! each set in the order it is DECLARED -- minimal is not in catalogue order,
    ! and sorting it would silently rewrite every minimal file ever written.
    n_vel = 0_C_INT
    n_scal = 0_C_INT
    if (convvelo_output_mode == "full") then
      ! Catalogue order minus the dt fields: acc_convvelo_stats does not make
      ! those, so full has never included them and still does not.
      do i = 1, n_convvelo_velocity_fields_total
        if (dt_velocity_component(i) == 0) call append_field_id(vel_ids, n_vel, i)
      end do
      do i = 1, n_convvelo_scalar_fields_total
        if (.not. is_dt_scalar_id(i)) call append_field_id(scal_ids, n_scal, i)
      end do
    else if (convvelo_output_mode == "minimal") then
      do i = 1, size(minimal_velocity_field_ids)
        call append_field_id(vel_ids, n_vel, minimal_velocity_field_ids(i))
      end do
      do i = 1, size(minimal_scalar_field_ids)
        call append_field_id(scal_ids, n_scal, minimal_scalar_field_ids(i))
      end do
    end if

    ! The direct set unions in, appended in its own declared order.  The energies
    ! it needs are already in full and minimal, so in practice only the dt fields
    ! land at the end -- which leaves every pre-existing field where it was.
    if (convvelo_direct_enabled) then
      do i = 1, size(direct_velocity_field_ids)
        call append_field_id(vel_ids, n_vel, direct_velocity_field_ids(i))
      end do
      do i = 1, size(direct_scalar_field_ids)
        call append_field_id(scal_ids, n_scal, direct_scalar_field_ids(i))
      end do
    end if

    allocate (convvelo_velocity_field_ids(n_vel))
    allocate (convvelo_scalar_field_ids(n_scal))
    convvelo_velocity_field_ids = vel_ids(1:n_vel)
    convvelo_scalar_field_ids = scal_ids(1:n_scal)

    n_convvelo_velocity_fields = size(convvelo_velocity_field_ids)
    n_convvelo_scalar_fields = size(convvelo_scalar_field_ids)
    n_convvelo_fields = n_convvelo_velocity_fields + nPhi*n_convvelo_scalar_fields

    allocate (convvelo_field_map(n_convvelo_velocity_fields_total + nPhi*n_convvelo_scalar_fields_total))
    allocate (convvelo_output_source(max(n_convvelo_fields, 1)))
    allocate (convvelo_direct_output(3 + nPhi))
    convvelo_field_map = 0_C_INT
    convvelo_output_source = 0_C_INT
    convvelo_direct_output = 0_C_INT

    do i = 1, n_convvelo_velocity_fields
      convvelo_field_map(convvelo_velocity_field_ids(i)) = i
    end do
    do iPhi = 1, nPhi
      do raw_field_index = 1, n_convvelo_scalar_fields
        convvelo_field_map(n_convvelo_velocity_fields_total + (iPhi - 1)*n_convvelo_scalar_fields_total + &
                           convvelo_scalar_field_ids(raw_field_index)) = &
          n_convvelo_velocity_fields + (iPhi - 1)*n_convvelo_scalar_fields + raw_field_index
      end do
    end do

    ! Walk the output fields in file order, handing each a slot in whichever
    ! array holds it.  Direct slots are numbered by component, u v w phi1..phiN,
    ! so accumulate_direct_numerator can index them without a lookup.
    n_convvelo_direct_fields = 0_C_INT
    if (convvelo_direct_enabled) n_convvelo_direct_fields = 3_C_INT + nPhi
    stats_slot = 0_C_INT

    do i = 1, n_convvelo_velocity_fields
      out_index = i
      component = dt_velocity_component(convvelo_velocity_field_ids(i))
      if (component > 0) then
        convvelo_output_source(out_index) = -component
        convvelo_direct_output(component) = out_index
      else
        stats_slot = stats_slot + 1_C_INT
        convvelo_output_source(out_index) = stats_slot
      end if
    end do
    do iPhi = 1, nPhi
      do raw_field_index = 1, n_convvelo_scalar_fields
        out_index = n_convvelo_velocity_fields + (iPhi - 1)*n_convvelo_scalar_fields + raw_field_index
        if (is_dt_scalar_id(convvelo_scalar_field_ids(raw_field_index))) then
          component = 3_C_INT + iPhi
          convvelo_output_source(out_index) = -component
          convvelo_direct_output(component) = out_index
        else
          stats_slot = stats_slot + 1_C_INT
          convvelo_output_source(out_index) = stats_slot
        end if
      end do
    end do
    n_convvelo_stats_fields = stats_slot
  end subroutine init_convvelo_field_layout

  ! Appends a field id unless it is already in the list, so unioning the direct
  ! set into full or minimal never duplicates the energies they share.
  subroutine append_field_id(ids, n, id)
    implicit none
    integer(C_INT), intent(inout) :: ids(:)
    integer(C_INT), intent(inout) :: n
    integer(C_INT), intent(in) :: id

    if (n > 0) then
      if (any(ids(1:n) == id)) return
    end if
    n = n + 1_C_INT
    ids(n) = id
  end subroutine append_field_id

  ! Which velocity component a dt field belongs to, or 0 if it is not one.
  integer(C_INT) function dt_velocity_component(field_id)
    implicit none
    integer(C_INT), intent(in) :: field_id
    integer(C_INT) :: i

    dt_velocity_component = 0_C_INT
    do i = 1, size(dt_velocity_field_ids)
      if (field_id == dt_velocity_field_ids(i)) then
        dt_velocity_component = i
        return
      end if
    end do
  end function dt_velocity_component

  logical function is_dt_scalar_id(field_id)
    implicit none
    integer(C_INT), intent(in) :: field_id

    is_dt_scalar_id = any(dt_scalar_field_ids == field_id)
  end function is_dt_scalar_id

  subroutine reset_convvelo_stats()
    implicit none
    integer(C_INT) :: field_index, iy, iz, ix, ic

    if (.not. convvelo_initialized) return

    !$omp target teams distribute parallel do collapse(4) &
    !$omp shared(convvelo_stats, n_convvelo_stats_fields, ny0, nyN, nx0, nxN, nz) private(field_index, ix, iz, iy)
    do field_index = 1, n_convvelo_stats_fields
      do ix = nx0, nxN
        do iz = -nz, nz
          do iy = ny0 - 2, nyN + 2
            convvelo_stats(iy, iz, ix, field_index) = (0.0d0, 0.0d0)
          end do
        end do
      end do
    end do

    !$omp target teams distribute parallel do collapse(2) &
    !$omp shared(component_means, ny0, nyN, nPhi) private(ic, iy)
    do ic = 1, 3 + nPhi
      do iy = ny0 - 2, nyN + 2
        component_means(iy, ic) = (0.0d0, 0.0d0)
      end do
    end do
    n_field_samples = 0_C_INT64_T

    if (convvelo_direct_enabled) then
      !$omp target teams distribute parallel do collapse(4) &
      !$omp shared(convvelo_direct, nPhi, ny0, nyN, nx0, nxN, nz) private(ic, ix, iz, iy)
      do ic = 1, 3 + nPhi
        do ix = nx0, nxN
          do iz = -nz, nz
            do iy = ny0 - 2, nyN + 2
              convvelo_direct(iy, iz, ix, ic) = 0.0d0
            end do
          end do
        end do
      end do
      convvelo_energy_rate = 0.0d0
      convvelo_n_triplets = 0_C_INT64_T
      convvelo_n_dropped = 0_C_INT64_T
      convvelo_sum_h1 = 0.0d0
      convvelo_sum_h2 = 0.0d0
      convvelo_min_h = 0.0d0
      convvelo_max_h = 0.0d0
      ! A half-built triplet does not survive a reset: its n-1 and n levels
      ! belong to an averaging window that no longer exists.
      convvelo_direct_state = cvv_idle
    end if

    n_mean_samples = 0_C_INT64_T
    convvelo_average_start_time = 0.0d0
    convvelo_average_end_time = 0.0d0
    convvelo_dirty = .false.
  end subroutine reset_convvelo_stats

  subroutine update_convvelo_component_means()
    implicit none

    complex(C_DOUBLE_COMPLEX) :: snapshot(ny0 - 2:nyN + 2, 1:3 + nPhi)
    real(C_DOUBLE) :: old_weight, new_weight
    integer(C_INT) :: iy, ic

    if (.not. convvelo_initialized) call init_convvelo()

    snapshot = (0.0d0, 0.0d0)

    if (has_average) then
      !$omp target teams distribute parallel do collapse(2)  &
      !$omp shared(snapshot, V, ny0, nyN, nPhi) private(ic, iy) map(tofrom: snapshot)
      do ic = 1, 3 + nPhi
        do iy = ny0 - 2, nyN + 2
          snapshot(iy, ic) = V(iy, 0, 0, ic)
        end do
      end do
    end if

    if (n_mean_samples == 0_C_INT64_T) convvelo_average_start_time = time
    n_mean_samples = n_mean_samples + 1_C_INT64_T
    convvelo_average_end_time = time
    old_weight = dble(n_mean_samples - 1_C_INT64_T)/dble(n_mean_samples)
    new_weight = 1.0d0/dble(n_mean_samples)
    !$omp target teams distribute parallel do collapse(2)  &
    !$omp shared(component_means, snapshot, old_weight, new_weight, ny0, nyN, nPhi) private(ic, iy) map(to: snapshot)
    do ic = 1, 3 + nPhi
      do iy = ny0 - 2, nyN + 2
        component_means(iy, ic) = old_weight*component_means(iy, ic) + new_weight*snapshot(iy, ic)
      end do
    end do
    convvelo_dirty = .true.
  end subroutine update_convvelo_component_means

  subroutine acc_convvelo_stats()
    implicit none
    integer(C_INT) :: iPhi, scalar_component

    if (.not. convvelo_initialized) call init_convvelo()
    call accumulate_cross_components(iv_u_cross_u, i_u, i_u)
    call accumulate_cross_derivative(iv_u_cross_dyu, i_u, i_u, 1)
    call accumulate_cross_components(iv_u_cross_v, i_u, i_v)
    call accumulate_cross_derivative(iv_u_cross_dyv, i_u, i_v, 1)
    call accumulate_cross_components(iv_u_cross_w, i_u, i_w)
    call accumulate_cross_derivative(iv_u_cross_dyw, i_u, i_w, 1)
    call accumulate_cross_derivative(iv_u_cross_dyyu, i_u, i_u, 2)

    call accumulate_cross_components(iv_v_cross_u, i_v, i_u)
    call accumulate_cross_derivative(iv_v_cross_dyu, i_v, i_u, 1)
    call accumulate_cross_components(iv_v_cross_v, i_v, i_v)
    call accumulate_cross_derivative(iv_v_cross_dyv, i_v, i_v, 1)
    call accumulate_cross_components(iv_v_cross_w, i_v, i_w)
    call accumulate_cross_derivative(iv_v_cross_dyw, i_v, i_w, 1)
    call accumulate_cross_derivative(iv_v_cross_dyyv, i_v, i_v, 2)

    call accumulate_cross_components(iv_w_cross_u, i_w, i_u)
    call accumulate_cross_derivative(iv_w_cross_dyu, i_w, i_u, 1)
    call accumulate_cross_components(iv_w_cross_v, i_w, i_v)
    call accumulate_cross_derivative(iv_w_cross_dyv, i_w, i_v, 1)
    call accumulate_cross_components(iv_w_cross_w, i_w, i_w)
    call accumulate_cross_derivative(iv_w_cross_dyw, i_w, i_w, 1)
    call accumulate_cross_derivative(iv_w_cross_dyyw, i_w, i_w, 2)

    do iPhi = 1, nPhi
      scalar_component = i_w + iPhi
      call accumulate_cross_components(scalar_field_slot(iPhi, is_t_cross_t), scalar_component, scalar_component)
      call accumulate_cross_components(scalar_field_slot(iPhi, is_t_cross_u), scalar_component, i_u)
      call accumulate_cross_components(scalar_field_slot(iPhi, is_t_cross_v), scalar_component, i_v)
      call accumulate_cross_components(scalar_field_slot(iPhi, is_t_cross_w), scalar_component, i_w)
      call accumulate_cross_product_field(scalar_field_slot(iPhi, is_t_cross_tu), scalar_component, scalar_component, i_u)
      call accumulate_cross_product_field(scalar_field_slot(iPhi, is_t_cross_tw), scalar_component, scalar_component, i_w)
      call accumulate_cross_derivative(scalar_field_slot(iPhi, is_t_cross_dyyt), scalar_component, scalar_component, 2)
      call accumulate_cross_product_derivative_field(scalar_field_slot(iPhi, is_t_cross_dytv), scalar_component, scalar_component, i_v)
      call accumulate_cross_derivative(scalar_field_slot(iPhi, is_t_cross_dyt), scalar_component, scalar_component, 1)
      call accumulate_cross_derivative(scalar_field_slot(iPhi, is_t_cross_dyv), scalar_component, i_v, 1)
    end do
    call accumulate_cross_product_field(iv_u_cross_uu, i_u, i_u, i_u)
    call accumulate_cross_product_field(iv_u_cross_uw, i_u, i_u, i_w)
    call accumulate_cross_product_field(iv_v_cross_uv, i_v, i_u, i_v)
    call accumulate_cross_product_field(iv_v_cross_vw, i_v, i_v, i_w)
    call accumulate_cross_product_field(iv_w_cross_uw, i_w, i_u, i_w)
    call accumulate_cross_product_field(iv_w_cross_ww, i_w, i_w, i_w)
    call accumulate_cross_product_derivative_field(iv_u_cross_dyuv, i_u, i_u, i_v)
    call accumulate_cross_product_derivative_field(iv_v_cross_dyvv, i_v, i_v, i_v)
    call accumulate_cross_product_derivative_field(iv_w_cross_dyvw, i_w, i_v, i_w)

    call accumulate_cross_pressure(iv_u_cross_p, i_u, .false.)
    call accumulate_cross_pressure(iv_v_cross_dpdy, i_v, .true.)
    call accumulate_cross_pressure(iv_w_cross_p, i_w, .false.)
  end subroutine acc_convvelo_stats

  subroutine finish_convvelo_field(field_index)
    implicit none

    integer(C_INT), intent(in) :: field_index
    integer(C_INT) :: output_index, storage_index
    integer(C_INT) :: ix, iy, iz

    if (.not. convvelo_initialized) call init_convvelo()
    if (field_index < 1 .or. field_index > size(convvelo_field_map)) then
      error stop "finish_convvelo_field: field_index out of range"
    end if
    output_index = convvelo_field_map(field_index)
    if (output_index == 0) return
    storage_index = convvelo_output_source(output_index)
    if (storage_index <= 0) then
      error stop "finish_convvelo_field: a dt field cannot be accumulated this way"
    end if

    n_field_samples(output_index) = n_field_samples(output_index) + 1_C_INT64_T
    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(convvelo_stats, convvelo_work, storage_index, ny0, nyN, nz, nx0, nxN) private(ix, iz, iy)
    do ix = nx0, nxN
      do iz = -nz, nz
        do iy = ny0 - 2, nyN + 2
          convvelo_stats(iy, iz, ix, storage_index) = convvelo_stats(iy, iz, ix, storage_index) + convvelo_work(iy, iz, ix)
        end do
      end do
    end do
  end subroutine finish_convvelo_field

  ! Copies the current spectral field into one of the two saved time levels.
  subroutine save_convvelo_time_level(level)
    implicit none
    complex(C_DOUBLE_COMPLEX), intent(inout) :: level(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN, 1:3 + nPhi)
    integer(C_INT) :: ic, ix, iz, iy

    !$omp target teams distribute parallel do collapse(4) &
    !$omp shared(level, V, nPhi, ny0, nyN, nz, nx0, nxN) private(ic, ix, iz, iy)
    do ic = 1, 3 + nPhi
      do ix = nx0, nxN
        do iz = -nz, nz
          do iy = ny0 - 2, nyN + 2
            level(iy, iz, ix, ic) = V(iy, iz, ix, ic)
          end do
        end do
      end do
    end do
  end subroutine save_convvelo_time_level

  ! The direct estimator.  With the three time levels n-1, n, n+1 at spacings
  ! h1 = t_n - t_(n-1) and h2 = t_(n+1) - t_n, the second-order derivative at the
  ! middle node is the exact Lagrange one,
  !
  !   du/dt|n = a u_(n-1) + b u_n + c u_(n+1)
  !   a = -h2/(h1(h1+h2))   b = (h2-h1)/(h1 h2)   c = h1/(h2(h1+h2))
  !
  ! which collapses to (u_(n+1) - u_(n-1))/2h when h1 = h2 and stays second
  ! order when they differ, because a h1^2 + c h2^2 vanishes by construction.
  ! deltat is therefore never frozen for our benefit.
  !
  ! Only Im<u* du/dt> is kept: it is the whole numerator of the convection
  ! velocity, and storing it real rather than complex is what lets the direct
  ! fields live outside convvelo_stats.  The real part -- half the rate of change
  ! of the modal energy -- is summed globally as a cheap check that the operator
  ! is assembled correctly, and lands in the .timing sidecar.
  subroutine accumulate_direct_numerator(h1, h2)
    implicit none
    real(C_DOUBLE), intent(in) :: h1, h2
    real(C_DOUBLE) :: ca, cb, cc, rate
    complex(C_DOUBLE_COMPLEX) :: centre, dudt
    integer(C_INT) :: ic, ix, iz, iy, output_index

    if (h1 <= 0.0d0 .or. h2 <= 0.0d0) then
      error stop "accumulate_direct_numerator: non-positive step inside a triplet"
    end if

    ca = -h2/(h1*(h1 + h2))
    cb = (h2 - h1)/(h1*h2)
    cc = h1/(h2*(h1 + h2))

    do ic = 1, 3 + nPhi
      output_index = convvelo_direct_output(ic)
      if (output_index == 0) cycle
      n_field_samples(output_index) = n_field_samples(output_index) + 1_C_INT64_T
      rate = 0.0d0
      !$omp target teams distribute parallel do collapse(3) reduction(+: rate) &
      !$omp shared(convvelo_direct, convvelo_prev1, convvelo_prev2, V, ca, cb, cc, ic, &
      !$omp        ny0, nyN, nz, nx0, nxN) private(ix, iz, iy, centre, dudt)
      do ix = nx0, nxN
        do iz = -nz, nz
          do iy = ny0 - 2, nyN + 2
            centre = convvelo_prev2(iy, iz, ix, ic)
            dudt = ca*convvelo_prev1(iy, iz, ix, ic) + cb*centre + cc*V(iy, iz, ix, ic)
            dudt = conjg(centre)*dudt
            convvelo_direct(iy, iz, ix, ic) = convvelo_direct(iy, iz, ix, ic) + aimag(dudt)
            rate = rate + real(dudt, C_DOUBLE)
          end do
        end do
      end do
      convvelo_energy_rate(ic) = convvelo_energy_rate(ic) + rate
    end do

    convvelo_n_triplets = convvelo_n_triplets + 1_C_INT64_T
    convvelo_sum_h1 = convvelo_sum_h1 + h1
    convvelo_sum_h2 = convvelo_sum_h2 + h2
    if (convvelo_n_triplets == 1_C_INT64_T) then
      convvelo_min_h = min(h1, h2)
      convvelo_max_h = max(h1, h2)
    else
      convvelo_min_h = min(convvelo_min_h, h1, h2)
      convvelo_max_h = max(convvelo_max_h, h1, h2)
    end if
    convvelo_dirty = .true.
  end subroutine accumulate_direct_numerator

  subroutine load_component_to_work(component_index)
    implicit none
    integer(C_INT), intent(in) :: component_index
    integer(C_INT) :: iy, iz, ix

    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(convvelo_work, V, component_index, ny0, nyN, nz, nx0, nxN) private(ix, iz, iy)
    do ix = nx0, nxN
      do iz = -nz, nz
        do iy = ny0 - 2, nyN + 2
          convvelo_work(iy, iz, ix) = V(iy, iz, ix, component_index)
        end do
      end do
    end do
  end subroutine load_component_to_work

  subroutine multiply_work_by_conjugate(component_index)
    implicit none
    integer(C_INT), intent(in) :: component_index
    integer(C_INT) :: iy, iz, ix

    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(convvelo_work, V, component_index, ny0, nyN, nx0, nxN, nz) private(ix, iz, iy)
    do ix = nx0, nxN
      do iz = -nz, nz
        do iy = ny0 - 2, nyN + 2
          convvelo_work(iy, iz, ix) = conjg(V(iy, iz, ix, component_index))*convvelo_work(iy, iz, ix)
        end do
      end do
    end do
  end subroutine multiply_work_by_conjugate

  subroutine load_convvelo_field_to_zbuf(component_index)
    implicit none
    integer(C_INT), intent(in) :: component_index
    integer(C_INT) :: iy, iz, ix, jx, izd_idx

    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(VVdz, nzd, nxB) private(iy, jx, izd_idx)
    do iy = ny0 - 2, nyN + 2
      do jx = 1, nxB
        do izd_idx = 1, nzd
          VVdz(izd_idx, jx, iy, 1) = (0.0d0, 0.0d0)
        end do
      end do
    end do
    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(VVdz, V, izd, ny, nz, nx0, nxN, component_index) private(ix, iz, iy, jx)
    do ix = nx0, nxN
      do iz = -nz, nz
        do iy = ny0 - 2, nyN + 2
          jx = ix - nx0 + 1
          VVdz(izd(iz) + 1, jx, iy, 1) = V(iy, iz, ix, component_index)
        end do
      end do
    end do
  end subroutine load_convvelo_field_to_zbuf

  subroutine accumulate_cross_components(field_index, lhs_component, rhs_component)
    implicit none
    integer(C_INT), intent(in) :: field_index, lhs_component, rhs_component

    if (.not. convvelo_field_requested(field_index)) return
    call load_component_to_work(rhs_component)
    call multiply_work_by_conjugate(lhs_component)
    call finish_convvelo_field(field_index)
  end subroutine accumulate_cross_components

  subroutine accumulate_cross_derivative(field_index, lhs_component, rhs_component, derivative_order)
    implicit none
    integer(C_INT), intent(in) :: field_index, lhs_component, rhs_component, derivative_order

    if (.not. convvelo_field_requested(field_index)) return
    select case (derivative_order)
    case (1)
      call apply_dy(V(:, :, :, rhs_component), convvelo_work)
    case (2)
      call apply_d2y(V(:, :, :, rhs_component), convvelo_work)
    case default
      error stop "accumulate_cross_derivative: unsupported derivative order"
    end select

    call multiply_work_by_conjugate(lhs_component)
    call finish_convvelo_field(field_index)
  end subroutine accumulate_cross_derivative

  subroutine accumulate_cross_pressure(field_index, lhs_component, use_dpdy)
    implicit none
    integer(C_INT), intent(in) :: field_index, lhs_component
    logical, intent(in) :: use_dpdy

    if (.not. convvelo_field_requested(field_index)) return
    if (use_dpdy) then
      call compute_dpdy(convvelo_work)
    else
      call compute_poisson(convvelo_work)
    end if
    call multiply_work_by_conjugate(lhs_component)
    call finish_convvelo_field(field_index)
  end subroutine accumulate_cross_pressure

  subroutine accumulate_cross_product_field(field_index, lhs_component, rhs0, rhs1)
    implicit none
    integer(C_INT), intent(in) :: field_index, lhs_component, rhs0, rhs1

    if (.not. convvelo_field_requested(field_index)) return
    call build_cross_product_work(rhs0, rhs1)
    call multiply_work_by_conjugate(lhs_component)
    call finish_convvelo_field(field_index)
  end subroutine accumulate_cross_product_field

  subroutine accumulate_cross_product_derivative_field(field_index, lhs_component, rhs0, rhs1)
    implicit none
    integer(C_INT), intent(in) :: field_index, lhs_component, rhs0, rhs1

    if (.not. convvelo_field_requested(field_index)) return
    call build_cross_product_work(rhs0, rhs1)
    call apply_dy_to_existing_work()
    call multiply_work_by_conjugate(lhs_component)
    call finish_convvelo_field(field_index)
  end subroutine accumulate_cross_product_derivative_field

  subroutine build_cross_product_work(rhs0, rhs1)
    implicit none
    integer(C_INT), intent(in) :: rhs0, rhs1
    integer(C_INT) :: iy, iz, ix

    call acquire_convvelo_real_workspace("convvelo_real")
    call load_convvelo_field_to_zbuf(rhs0)
    call spectral_field_to_real_x(convvelo_real0, "convvelo_spectral_to_real")
    call load_convvelo_field_to_zbuf(rhs1)
    call spectral_field_to_real_x(convvelo_real1, "convvelo_spectral_to_real")
    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(convvelo_real_prod, convvelo_real0, convvelo_real1, factor, nxd, nzB) private(ix, iz, iy)
    do iy = ny0 - 2, nyN + 2
      do iz = 1, nzB
        do ix = 1, 2*(nxd + 1)
          convvelo_real_prod(ix, iz, iy) = factor*convvelo_real0(ix, iz, iy)*convvelo_real1(ix, iz, iy)
        end do
      end do
    end do
    call real_x_to_spectral_field(convvelo_real_prod, convvelo_work, "convvelo_real_to_spectral")
    call release_convvelo_real_workspace("convvelo_real")
  end subroutine build_cross_product_work

  subroutine get_convvelo_real_workspace_bytes(real_bytes, fft_offset, total_bytes)
    implicit none
    integer(C_SIZE_T), intent(out) :: real_bytes, fft_offset, total_bytes
#if defined(HAVE_CUDA) || defined(HAVE_HIP)
    integer(C_SIZE_T) :: fft_bytes
#endif

    call get_convvelo_local_real_workspace_bytes(real_bytes)
#if defined(HAVE_CUDA) || defined(HAVE_HIP)
    call get_fft_workspace_bytes(fft_bytes)
    fft_offset = workspace_align_offset(real_bytes)
    total_bytes = workspace_align_offset(fft_offset + fft_bytes)
#else
    fft_offset = 0_C_SIZE_T
    total_bytes = real_bytes
#endif
  end subroutine get_convvelo_real_workspace_bytes

  ! Single description of the convvelo real-space slabs; see workspace_layout.
  subroutine convvelo_real_layout(bind, nbytes)
    implicit none
    logical, intent(in) :: bind
    integer(C_SIZE_T), intent(out) :: nbytes
    type(workspace_layout) :: lay

    call layout_begin(lay, bind)
    call layout_real_3d(lay, 1, 2*(nxd + 1), 1, nzB, ny0 - 2, nyN + 2, convvelo_real0)
    call layout_real_3d(lay, 1, 2*(nxd + 1), 1, nzB, ny0 - 2, nyN + 2, convvelo_real1)
    call layout_real_3d(lay, 1, 2*(nxd + 1), 1, nzB, ny0 - 2, nyN + 2, convvelo_real_prod)
    nbytes = layout_bytes(lay)
  end subroutine convvelo_real_layout

  subroutine get_convvelo_local_real_workspace_bytes(nbytes)
    implicit none
    integer(C_SIZE_T), intent(out) :: nbytes

    call convvelo_real_layout(.false., nbytes)
  end subroutine get_convvelo_local_real_workspace_bytes

  subroutine acquire_convvelo_real_workspace(owner)
    implicit none
    character(len=*), intent(in) :: owner
    type(C_PTR) :: base
    integer(C_SIZE_T) :: real_bytes, fft_offset, total_bytes

    call get_convvelo_real_workspace_bytes(real_bytes, fft_offset, total_bytes)
    call workspace_request(total_bytes, owner, base)
    call bind_convvelo_real_workspace()
#if defined(HAVE_CUDA) || defined(HAVE_HIP)
    call bind_fft_workspace(fft_offset)
#endif
  end subroutine acquire_convvelo_real_workspace

  subroutine release_convvelo_real_workspace(owner)
    implicit none
    character(len=*), intent(in) :: owner

#if defined(HAVE_CUDA) || defined(HAVE_HIP)
    call unbind_fft_workspace()
#endif
    call unbind_convvelo_real_workspace()
    call workspace_release(owner)
  end subroutine release_convvelo_real_workspace

  subroutine bind_convvelo_real_workspace()
    implicit none
    integer(C_SIZE_T) :: nbytes

    call convvelo_real_layout(.true., nbytes)

    !$omp target enter data map(alloc: convvelo_real0, convvelo_real1, convvelo_real_prod)
    !$omp target
    convvelo_real0(1, 1, ny0 - 2) = 0.0_C_DOUBLE
    convvelo_real1(1, 1, ny0 - 2) = 0.0_C_DOUBLE
    convvelo_real_prod(1, 1, ny0 - 2) = 0.0_C_DOUBLE
    !$omp end target
  end subroutine bind_convvelo_real_workspace

  subroutine unbind_convvelo_real_workspace()
    implicit none

    !$omp target exit data map(release: convvelo_real0, convvelo_real1, convvelo_real_prod)
    nullify (convvelo_real0, convvelo_real1, convvelo_real_prod)
  end subroutine unbind_convvelo_real_workspace

  subroutine apply_dy_to_existing_work()
    implicit none
    complex(C_DOUBLE_COMPLEX), allocatable :: deriv(:, :, :)
    integer(C_INT) :: ix, iy, iz

    allocate (deriv(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN))
    !$omp target enter data map(alloc: deriv)
    call apply_dy(convvelo_work, deriv)
    !$omp target teams distribute parallel do collapse(3) &
    !$omp shared(convvelo_work, deriv, ny0, nyN, nz, nx0, nxN) private(ix, iz, iy)
    do ix = nx0, nxN
      do iz = -nz, nz
        do iy = ny0 - 2, nyN + 2
          convvelo_work(iy, iz, ix) = deriv(iy, iz, ix)
        end do
      end do
    end do
    !$omp target exit data map(delete: deriv)
    deallocate (deriv)
  end subroutine apply_dy_to_existing_work

  subroutine free_convvelo()
    implicit none

    if (.not. convvelo_initialized) return

    !$omp target exit data map(delete: convvelo_stats, convvelo_work, component_means)
    deallocate (convvelo_stats, convvelo_work, component_means, n_field_samples)
    if (allocated(convvelo_direct)) then
      !$omp target exit data map(delete: convvelo_direct, convvelo_prev1, convvelo_prev2)
      deallocate (convvelo_direct, convvelo_prev1, convvelo_prev2)
    end if
    if (allocated(convvelo_energy_rate)) deallocate (convvelo_energy_rate)
    if (allocated(convvelo_velocity_field_ids)) deallocate (convvelo_velocity_field_ids)
    if (allocated(convvelo_scalar_field_ids)) deallocate (convvelo_scalar_field_ids)
    if (allocated(convvelo_field_map)) deallocate (convvelo_field_map)
    if (allocated(convvelo_output_source)) deallocate (convvelo_output_source)
    if (allocated(convvelo_direct_output)) deallocate (convvelo_direct_output)

    convvelo_direct_state = cvv_idle
    convvelo_write_pending = .false.
    n_convvelo_stats_fields = 0
    n_convvelo_direct_fields = 0
    n_convvelo_fields = 0
    n_convvelo_velocity_fields = 0
    n_convvelo_scalar_fields = 0
    convvelo_last_write_index = -1_C_INT64_T
    n_mean_samples = 0_C_INT64_T
    convvelo_average_start_time = 0.0d0
    convvelo_average_end_time = 0.0d0
    convvelo_dirty = .false.
    convvelo_initialized = .false.
  end subroutine free_convvelo

  logical function convvelo_has_pending_output()
    implicit none

    convvelo_has_pending_output = convvelo_initialized .and. convvelo_dirty .and. &
                                  (n_mean_samples > 0_C_INT64_T .or. any(n_field_samples > 0_C_INT64_T))
  end function convvelo_has_pending_output

  subroutine init_convvelo_runtime()
    implicit none

    if (.not. convvelo_enabled) return

    call init_convvelo()
    call reset_convvelo_stats()
    if (convvelo_dt_write > 0.0d0) then
      convvelo_last_write_index = int(floor((time + 0.5d0*deltat)/convvelo_dt_write), C_INT64_T)
    else
      convvelo_last_write_index = -1_C_INT64_T
    end if
    call write_convvelo_layout_file(convvelo_runtime_filename, convvelo_profile_field_names, &
                                    velocity_field_names(convvelo_velocity_field_ids), &
                                    scalar_field_names(convvelo_scalar_field_ids))
  end subroutine init_convvelo_runtime

  subroutine advance_convvelo_runtime()
    implicit none
    logical :: trigger

    if (.not. convvelo_enabled) return

    trigger = crossed_convvelo_interval(convvelo_dt_compute, convvelo_t_start)

    if (convvelo_direct_enabled) then
      ! One trigger becomes a three-step burst.  The trigger step is taken as
      ! n-1, so the sample centres one deltat after the nominal trigger time --
      ! negligible against dt_compute, and it avoids having to predict the
      ! trigger a step ahead, which adaptive deltat makes unreliable.
      select case (convvelo_direct_state)
      case (cvv_idle)
        if (trigger) then
          call save_convvelo_time_level(convvelo_prev1)
          convvelo_t1 = time
          convvelo_direct_state = cvv_armed
        end if
      case (cvv_armed)
        if (trigger) convvelo_n_dropped = convvelo_n_dropped + 1_C_INT64_T
        call save_convvelo_time_level(convvelo_prev2)
        convvelo_t2 = time
        ! The reconstruction is accumulated here, at the centre of the triplet,
        ! so both estimates share a time and a denominator.
        if (has_terminal) write (*, *) "Computing convvelo stats at time ", time
        call update_convvelo_component_means()
        call acc_convvelo_stats()
        convvelo_direct_state = cvv_middle
      case (cvv_middle)
        if (trigger) convvelo_n_dropped = convvelo_n_dropped + 1_C_INT64_T
        call accumulate_direct_numerator(convvelo_t2 - convvelo_t1, time - convvelo_t2)
        convvelo_direct_state = cvv_idle
      end select
    else
      if (trigger) then
        if (has_terminal) write (*, *) "Computing convvelo stats at time ", time
        call update_convvelo_component_means()
        call acc_convvelo_stats()
      end if
    end if

    if (convvelo_dt_write > 0.0d0) then
      ! crossed_convvelo_interval is an edge detector, so the crossing has to be
      ! latched: a write that lands mid-triplet is deferred until the triplet
      ! closes, at most two steps, rather than resetting a half-built one.
      if (crossed_convvelo_interval(convvelo_dt_write, convvelo_t_start)) convvelo_write_pending = .true.
      if (convvelo_write_pending .and. convvelo_direct_state == cvv_idle .and. convvelo_has_pending_output()) then
        if (has_terminal) write (*, *) "Writing convvelo snapshot at time ", time
        call write_convvelo_runtime_snapshot()
        convvelo_write_pending = .false.
      end if
    end if
  end subroutine advance_convvelo_runtime

  subroutine finalize_convvelo_runtime()
    implicit none

    if (.not. convvelo_enabled) return

    if (convvelo_has_pending_output()) then
      call write_convvelo_runtime_snapshot()
    end if
    call free_convvelo()
  end subroutine finalize_convvelo_runtime

  subroutine write_convvelo_runtime_snapshot()
    implicit none
    character(len=256) :: snapshot_filename
    character(len=32) :: index_string
    logical :: exists

    convvelo_last_write_index = 0_C_INT64_T
    do
      write (index_string, '(I0)') convvelo_last_write_index
      snapshot_filename = "convvelo."//trim(index_string)//".bin"
      inquire (file=trim(snapshot_filename), exist=exists)
      if (.not. exists) exit
      convvelo_last_write_index = convvelo_last_write_index + 1_C_INT64_T
    end do

    if (has_terminal) write (*, *) "Writing "//trim(snapshot_filename)//" at time ", time
    call write_convvelo_raw_stats(snapshot_filename)
    call reset_convvelo_stats()
  end subroutine write_convvelo_runtime_snapshot

  ! Brings the statistics back from the device and hands them to convvelo_io,
  ! which owns the file format.
  subroutine write_convvelo_raw_stats(filename)
    implicit none

    character(len=*), intent(in) :: filename

    if (.not. convvelo_initialized) return

    call update_convvelo_stats_from_device()
    !$omp target update from(component_means)
    if (convvelo_direct_enabled) then
      !$omp target update from(convvelo_direct)
      call write_convvelo_raw_file(filename, n_convvelo_fields, convvelo_output_source, &
                                   convvelo_stats, max(n_convvelo_stats_fields, 1), n_field_samples, &
                                   component_means, n_mean_samples, &
                                   convvelo_average_start_time, convvelo_average_end_time, &
                                   direct=convvelo_direct)
      call write_convvelo_timing_file(filename, convvelo_n_triplets, convvelo_n_dropped, &
                                      convvelo_sum_h1, convvelo_sum_h2, convvelo_min_h, convvelo_max_h, &
                                      convvelo_energy_rate)
    else
      call write_convvelo_raw_file(filename, n_convvelo_fields, convvelo_output_source, &
                                   convvelo_stats, max(n_convvelo_stats_fields, 1), n_field_samples, &
                                   component_means, n_mean_samples, &
                                   convvelo_average_start_time, convvelo_average_end_time)
    end if
  end subroutine write_convvelo_raw_stats

  subroutine update_convvelo_stats_from_device()
    implicit none

    !$omp target update from(convvelo_stats)
  end subroutine update_convvelo_stats_from_device

  subroutine fill_convvelo_synthetic_state_for_test()
    implicit none
    integer(C_INT) :: ix, iy, iz, field_index, component
    integer(C_INT64_T), parameter :: mean_samples = 7_C_INT64_T
    integer(C_INT64_T), parameter :: field_samples = 11_C_INT64_T

    if (.not. convvelo_initialized) error stop "fill_convvelo_synthetic_state_for_test requires init_convvelo"

    convvelo_average_start_time = 1.25d0
    convvelo_average_end_time = 2.50d0
    n_mean_samples = mean_samples
    n_field_samples = field_samples

    do component = 1, 3 + nPhi
      do iy = ny0 - 2, nyN + 2
        component_means(iy, component) = synthetic_profile_value(iy, component)
      end do
    end do

    do field_index = 1, n_convvelo_fields
      do ix = nx0, nxN
        do iz = -nz, nz
          do iy = ny0 - 2, nyN + 2
            convvelo_stats(iy, iz, ix, field_index) = real(field_samples, C_DOUBLE)* &
                                                      synthetic_field_value(iy, iz, ix, field_index)
          end do
        end do
      end do
    end do
    !$omp target update to(convvelo_stats)
    !$omp target update to(component_means)
  end subroutine fill_convvelo_synthetic_state_for_test

  pure complex(C_DOUBLE_COMPLEX) function synthetic_profile_value(iy, component)
    implicit none
    integer(C_INT), intent(in) :: iy, component

    synthetic_profile_value = cmplx(100.0d0*real(component, C_DOUBLE) + real(iy, C_DOUBLE), &
                                    -10.0d0*real(component, C_DOUBLE) + 0.125d0*real(iy, C_DOUBLE), &
                                    kind=C_DOUBLE)
  end function synthetic_profile_value

  pure complex(C_DOUBLE_COMPLEX) function synthetic_field_value(iy, iz, ix, field_index)
    implicit none
    integer(C_INT), intent(in) :: iy, iz, ix, field_index

    synthetic_field_value = cmplx(1000.0d0*real(field_index, C_DOUBLE) + &
                                  10.0d0*real(ix, C_DOUBLE) + &
                                  0.5d0*real(iz, C_DOUBLE) + &
                                  0.03125d0*real(iy, C_DOUBLE), &
                                  -200.0d0*real(field_index, C_DOUBLE) + &
                                  0.25d0*real(ix, C_DOUBLE) - &
                                  0.0625d0*real(iz, C_DOUBLE) + &
                                  0.0078125d0*real(iy, C_DOUBLE), &
                                  kind=C_DOUBLE)
  end function synthetic_field_value

  subroutine copy_convvelo_field_average(field_index, field)
    implicit none
    integer(C_INT), intent(in) :: field_index
    complex(C_DOUBLE_COMPLEX), intent(out) :: field(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN)

    call update_convvelo_stats_from_device()
    if (convvelo_output_source(field_index) > 0) then
      call average_convvelo_field(max(n_convvelo_stats_fields, 1), convvelo_stats, &
                                  n_field_samples(field_index), convvelo_output_source(field_index), field)
    else
      !$omp target update from(convvelo_direct)
      call average_convvelo_direct_field(convvelo_direct, n_field_samples(field_index), &
                                         -convvelo_output_source(field_index), field)
    end if
  end subroutine copy_convvelo_field_average

  ! Raw field id of scalar `scalar_id` for the i_phi-th scalar: the scalar
  ! blocks follow the velocity block, one full block per scalar.
  pure integer(C_INT) function scalar_field_slot(i_phi, scalar_id)
    implicit none
    integer(C_INT), intent(in) :: i_phi, scalar_id

    scalar_field_slot = n_convvelo_velocity_fields_total + (i_phi - 1)*n_convvelo_scalar_fields_total + scalar_id
  end function scalar_field_slot

  logical function convvelo_field_requested(field_index)
    implicit none
    integer(C_INT), intent(in) :: field_index

    if (.not. allocated(convvelo_field_map)) then
      convvelo_field_requested = .false.
      return
    end if
 convvelo_field_requested = field_index >= 1 .and. field_index <= size(convvelo_field_map) .and. convvelo_field_map(field_index) > 0
  end function convvelo_field_requested

  logical function crossed_convvelo_interval(period, t_start)
    implicit none
    real(C_DOUBLE), intent(in) :: period, t_start

    crossed_convvelo_interval = .false.
    if (period <= 0.0d0) return
    if (time + 0.5d0*deltat < t_start) return

    crossed_convvelo_interval = floor((time + 0.5d0*deltat - t_start)/period) > &
                                floor((time - 0.5d0*deltat - t_start)/period)
  end function crossed_convvelo_interval

end module convvelo
