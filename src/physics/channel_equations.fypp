#include "build_options.h"
#:include "channel_operators.fypph"
#:include "stencil_macros.fypph"

! The equations of the channel formulation.
!
! Incompressible Navier-Stokes in velocity-vorticity (v, eta) form.  In each
! Fourier mode the wall-parallel derivatives are algebraic, so each mode
! reduces to a pair of wall-normal problems:
!
!   v   : lambda*(D^2 - k^2) v - ni*(D^2 - k^2)^2 v = explicit terms
!   eta : lambda*eta         - ni*(D^2 - k^2) eta  = explicit terms
!
! plus one Helmholtz problem per passive scalar.  The implicit halves are
! assembled into banded matrices by the assemble_* routines below; the
! explicit halves -- the nonlinear products and the viscous terms carried over
! from the previous Runge-Kutta substep -- are built by build_products and
! buildrhs.  Both halves of each operator come from the single definitions in
! channel_operators.fypph.
!
! This module holds the physics, and only the physics.  Its whole contract with
! the numerics is: fill ctx%system_matrix and ctx%system_rhs in a callback, then
! hand the callback to solve_wall_normal_component.  How that system
! is closed at the walls, eliminated, distributed over ranks and solved is
! compact_component_solve's business, and this file says nothing about it.
!
! It contains no MPI, no FFT and no linear algebra of its own.
#! The right-hand side of an assembled system: the y-fastest field copied to
#! the z-fastest system layout in (iz, iy) tiles.
#:def assemble_rhs_tiles()
    !$omp target teams distribute parallel do collapse(5) default(none) &
    !$omp shared(owner_src, system_rhs, nz, ix0_owner, ixN_owner, row_start, row_end) &
    !$omp private(ix, iz, iy, izb, iyb, izi, iyi)
$:tile_zy_open(ix0='ix0_owner', ix1='ixN_owner', y0='row_start', y1='row_end')
              system_rhs(iz, ix, iy) = owner_src(iy, iz, ix)
$:tile_zy_close()
    !$omp end target teams distribute parallel do
#:enddef

#! ===================================================================
#! Real-arithmetic building blocks of the buildrhs kernels.
#!
#! The kernels below never use complex operators on the fields.  amdflang
#! compiles real*complex to a full complex multiply (with the 0*x terms kept)
#! and complex/real to a call to __divdc3 per point; written with explicit
#! real and imaginary parts the same stencils need a third of the
#! floating-point instructions.  ialfa and ibeta are purely imaginary, so
#! only a = dimag(ialfa(ix)) and b = dimag(ibeta(iz)) appear.
#! ===================================================================
#:set RJ = [(-2, 'm2'), (-1, 'm1'), (0, 'c0'), (1, 'p1'), (2, 'p2')]
#! Scalars d<order><row> = der(iy, order, row) for the listed orders.
#:def rhs_load_der(orders)
#:for o in orders
#:for j, t in RJ
          d${o}$${t}$ = der(iy, ${o}$, ${j}$)
#:endfor
#:endfor
#:enddef
#! One part ('dreal' or 'dimag') of the y stencil with coefficients cf<row>
#! applied to component comp of a y-fastest field.
#:def rhs_rsum(part, cf, field, comp)
(${' + '.join('{}{}*{}({}(iy + ({}), iz, ix, {}))'.format(cf, t, part, field, j, comp) for j, t in RJ)}$)
#:enddef
#:set RHS_DER_NAMES = ', '.join('d{}{}'.format(o, t) for o in range(4) for j, t in RJ) + ', ' + ', '.join('e{}'.format(t) for j, t in RJ)
#! The explicit terms of all six velocity products (VEL_RHS above, expanded):
#!   d2v:  -a^2 D1(uu) + k^2 D1(vv) - b^2 D1(ww) - 2ab D1(uw) + i [a (D2 + k^2 D0)(uv) + b (D2 + k^2 D0)(vw)]
#!   eta:  ab [D0(uu) - D0(ww)] + (b^2 - a^2) D0(uw) + i [a D1(vw) - b D1(uv)]
#!   mean (ix = iz = 0):  (-Re D1(uv), -Re D1(vw))
#! Result in n2r, n2i (d2v) and n1r, n1i (eta or mean).  Needs kk, a, b and
#! the der scalars of orders 0, 1, 2.
#:def rhs_nonlinear_real(field)
#:for j, t in RJ
          e${t}$ = d2${t}$ + kk*d0${t}$
#:endfor
#:for c in [1, 2, 3, 6, 4, 5]
          x1${c}$r = ${rhs_rsum('dreal', 'd1', field, c)}$
          x1${c}$i = ${rhs_rsum('dimag', 'd1', field, c)}$
#:endfor
#:for c in [1, 3, 6]
          x0${c}$r = ${rhs_rsum('dreal', 'd0', field, c)}$
          x0${c}$i = ${rhs_rsum('dimag', 'd0', field, c)}$
#:endfor
#:for c in [4, 5]
          xe${c}$r = ${rhs_rsum('dreal', 'e', field, c)}$
          xe${c}$i = ${rhs_rsum('dimag', 'e', field, c)}$
#:endfor
          aa = a*a; bb = b*b; ab = a*b
          n2r = kk*x12r - aa*x11r - bb*x13r - 2.0d0*ab*x16r - (a*xe4i + b*xe5i)
          n2i = kk*x12i - aa*x11i - bb*x13i - 2.0d0*ab*x16i + (a*xe4r + b*xe5r)
          if (ix == 0 .AND. iz == 0) then
            n1r = -x14r
            n1i = -x15r
          else
            n1r = ab*(x01r - x03r) + (bb - aa)*x06r - (a*x15i - b*x14i)
            n1i = ab*(x01i - x03i) + (bb - aa)*x06i + (a*x15r - b*x14r)
          end if
#:enddef
#:set RHS_NL_NAMES = 'aa, bb, ab, n1r, n1i, n2r, n2i, ' + ', '.join('x1{}{}'.format(c, p) for c in range(1, 7) for p in 'ri') + ', ' + ', '.join('x0{}{}'.format(c, p) for c in [1, 3, 6] for p in 'ri') + ', ' + ', '.join('xe{}{}'.format(c, p) for c in [4, 5] for p in 'ri')
#! The a-priori (linear) part of both velocity equations, minus ODE(3) times
#! the previous explicit term:
#!   d2v:  c1 (D2 - k^2) v + ni (D4 - 2 k^2 D2 + k^4) v
#!   eta:  [c1 + ni (D2 - k^2)] (i b u - i a w),  mean mode: (c1 + ni D2)(Re u, Re w)
#! with c1 = ODE(1)/deltat.  Per stencil row the fields are combined first
#! (u<row> = v, w<row> = b u - a w, or the mean pair), then the stencils are
#! applied to the combinations.  Result in m1r, m1i (eta) and m2r, m2i (d2v).
#! Needs kk, a, b, mean.  The order of the statements is measured, not
#! arbitrary: with the der loads placed before the field rows the kernel is
#! 20 % slower (13.3 vs 11.1 ms), and the general w followed by the mean-mode
#! override beat an if/else.
#:def rhs_linear_real()
#:for j, t in RJ
          u${t}$r = dreal(V(iy + (${j}$), iz, ix, 2)); u${t}$i = dimag(V(iy + (${j}$), iz, ix, 2))
          w${t}$r = b*dreal(V(iy + (${j}$), iz, ix, 1)) - a*dreal(V(iy + (${j}$), iz, ix, 3))
          w${t}$i = b*dimag(V(iy + (${j}$), iz, ix, 1)) - a*dimag(V(iy + (${j}$), iz, ix, 3))
          if (mean) then
            w${t}$r = dreal(V(iy + (${j}$), iz, ix, 3)); w${t}$i = -dreal(V(iy + (${j}$), iz, ix, 1))
          end if
#:endfor
$:rhs_load_der([0, 2, 3])
#:for o, nm in [(0, 's0'), (2, 's2'), (3, 's4')]
#:for p in 'ri'
          ${nm}$${p}$ = ${' + '.join('d{}{}*u{}{}'.format(o, t, t, p) for j, t in RJ)}$
#:endfor
#:endfor
#:for o, nm in [(0, 't0'), (2, 't2')]
#:for p in 'ri'
          ${nm}$${p}$ = ${' + '.join('d{}{}*w{}{}'.format(o, t, t, p) for j, t in RJ)}$
#:endfor
#:endfor
          m2r = c1*(s2r - kk*s0r) + ni*(s4r - 2.0d0*kk*s2r + kk*kk*s0r) - o3*dreal(oldrhs(iy, iz, ix, 2))
          m2i = c1*(s2i - kk*s0i) + ni*(s4i - 2.0d0*kk*s2i + kk*kk*s0i) - o3*dimag(oldrhs(iy, iz, ix, 2))
          m1r = -(c1*t0i + ni*(t2i - kk*t0i)) - o3*dreal(oldrhs(iy, iz, ix, 1))
          m1i = c1*t0r + ni*(t2r - kk*t0r) - o3*dimag(oldrhs(iy, iz, ix, 1))
#:enddef
#:set RHS_LIN_NAMES = 's0r, s0i, s2r, s2i, s4r, s4i, t0r, t0i, t2r, t2i, m1r, m1i, m2r, m2i, ' + ', '.join('{}{}{}'.format(x, t, p) for x in 'uw' for j, t in RJ for p in 'ri')

#! The buildrhs_prepare kernel for the velocity equations.  zero: also reset
#! oldrhs for kernels that accumulate into it (and add the mean-pressure
#! drive); without it oldrhs is only read.  ix outermost: the loop runs in
#! memory order.  All loads come before the first store (memrhs is a pointer
#! and V a target).
#:def prepare_velocity_kernel(zero)
      !$omp target teams distribute parallel do collapse(3) default(none)  &
      !$omp private(iz, ix, iy, mean, kk, a, b, ${RHS_DER_NAMES}$, ${RHS_LIN_NAMES}$) &
      !$omp shared(nz, nx0, nxN, y_first, y_last, ialfa, ibeta, k2, der, memrhs, oldrhs, V) &
      !$omp shared(ni, c1, o2, o3, meanpx, meanpz)
      DO ix = nx0, nxN
        DO iz = -nz, nz
          DO iy = y_first, y_last
          kk = k2(iz, ix); a = dimag(ialfa(ix)); b = dimag(ibeta(iz))
          mean = (ix == 0 .AND. iz == 0)
$:rhs_linear_real()
#:if zero
          if (mean) then
            m1r = m1r + o2*meanpx; m1i = m1i + o2*meanpz
          end if
#:endif
          memrhs(iy, iz, ix, 1) = dcmplx(m1r, m1i)
          memrhs(iy, iz, ix, 2) = dcmplx(m2r, m2i)
#:if zero
          if (mean) then
            oldrhs(iy, iz, ix, 1) = dcmplx(meanpx, meanpz)
          else
            oldrhs(iy, iz, ix, 1) = 0.0
          end if
          oldrhs(iy, iz, ix, 2) = 0.0
#:endif
          END DO
        END DO
      END DO
#:enddef

module channel_equations

  use, intrinsic :: iso_c_binding
  use channel_grid
  use channel_state
  use stencil_coefficients
  use compact_component_solve
  use mpi_transpose
  use roctx, only: roctxPush, roctxPop
  use ffts
  implicit none
  ! VVdz products stashed y-fastest for the fused buildrhs (buildrhs_stash).
  complex(C_DOUBLE_COMPLEX), allocatable, target, save :: rhs_stash(:, :, :, :)
  logical, save :: rhs_fuse_decided = .false., rhs_fuse = .false.
contains

  !--------------------------------------------------------------!
  !---------------- integral in the y-direction -----------------!
  PURE FUNCTION yintegr(f, y) result(II)
    IMPLICIT NONE
    complex(C_DOUBLE_COMPLEX), intent(in) :: f(-1:ny + 1)
    real(C_DOUBLE), intent(in) :: y(-1:ny + 1)
    real(C_DOUBLE) :: II, yp1, ym1, a1, a2, a3
    integer(C_INT) :: iy
    ! Device procedure: the directive sits in its own specification part, the one form
    ! that CCE, amdflang and nvfortran all accept (a module-level list makes CCE warn).
    !$omp declare target
    II = 0.0d0
    DO iy = 1, ny, 2
      yp1 = y(iy + 1) - y(iy); ym1 = y(iy - 1) - y(iy)
      a1 = -1.0d0/3.0d0*ym1 + 1.0d0/6.0d0*yp1 + 1.0d0/6.0d0*yp1*yp1/ym1
      a3 = +1.0d0/3.0d0*yp1 - 1.0d0/6.0d0*ym1 - 1.0d0/6.0d0*ym1*ym1/yp1
      a2 = yp1 - ym1 - a1 - a3
      II = II + a1*dreal(f(iy - 1)) + a2*dreal(f(iy)) + a3*dreal(f(iy + 1))
    END DO
  END FUNCTION yintegr

  subroutine assemble_compact_biharmonic_system(ctx)
    implicit none
    type(compact_assembly_context), intent(in) :: ctx
    integer(C_INT) :: ix, iz, iy, ix0_owner, ixN_owner, izb, iyb, izi, iyi
    integer(C_INT), parameter :: RHS_TILE = 8
    complex(C_DOUBLE_COMPLEX), pointer :: owner_src(:, :, :)
    YS_COEF, pointer :: system_matrix(:, :, :, :)
    complex(C_DOUBLE_COMPLEX), pointer :: system_rhs(:, :, :)
    integer(C_INT) :: row_start, row_end
    real(C_DOUBLE) :: lambda_coeff

    owner_src => ctx%src
    system_matrix => ctx%system_matrix
    system_rhs => ctx%system_rhs
    row_start = ctx%row_start
    row_end = ctx%row_end
    lambda_coeff = ctx%lambda
    ix0_owner = lbound(owner_src, 3)
    ixN_owner = ubound(owner_src, 3)

    ! The bands depend on iy and k^2 only and are written z-fastest, as the
    ! solver reads them: no transpose, so a plain z-innermost loop.  Only the
    ! right-hand side transposes the y-fastest field, in (iz, iy) tiles.  One
    ! tiled kernel for both cost 34% more: the tile bookkeeping outweighed
    ! coalescing for the five band stores, which needed none.
    !$omp target teams distribute parallel do collapse(3) default(none) &
    !$omp shared(der, k2, ni, lambda_coeff, system_matrix, nz, ix0_owner, ixN_owner, row_start, row_end) &
    !$omp private(ix, iz, iy)
    do iy = row_start, row_end
      do ix = ix0_owner, ixN_owner
        do iz = -nz, nz
          ! v equation, implicit half:  lambda*(D^2 - k^2) - ni*(D^2 - k^2)^2
#:for k in range(-2, 3)
          system_matrix(iz, ix, iy, ${k}$) = lambda_coeff*${helmholtz_op('iy', str(k))}$ - ni*${biharmonic_op('iy', str(k))}$
#:endfor
        end do
      end do
    end do
    !$omp end target teams distribute parallel do
$:assemble_rhs_tiles()
  end subroutine assemble_compact_biharmonic_system

  subroutine assemble_compact_helmholtz_system(ctx)
    implicit none
    type(compact_assembly_context), intent(in) :: ctx
    integer(C_INT) :: ix, iz, iy, ix0_owner, ixN_owner, izb, iyb, izi, iyi
    integer(C_INT), parameter :: RHS_TILE = 8
    complex(C_DOUBLE_COMPLEX), pointer :: owner_src(:, :, :)
    YS_COEF, pointer :: system_matrix(:, :, :, :)
    complex(C_DOUBLE_COMPLEX), pointer :: system_rhs(:, :, :)
    integer(C_INT) :: row_start, row_end
    real(C_DOUBLE) :: lambda_coeff, diffusion_coeff

    owner_src => ctx%src
    system_matrix => ctx%system_matrix
    system_rhs => ctx%system_rhs
    row_start = ctx%row_start
    row_end = ctx%row_end
    lambda_coeff = ctx%lambda
    diffusion_coeff = ctx%diffusion
    ix0_owner = lbound(owner_src, 3)
    ixN_owner = ubound(owner_src, 3)

    ! Bands untiled, right-hand side tiled: see the biharmonic system above.
    !$omp target teams distribute parallel do collapse(3) default(none) &
    !$omp shared(der, k2, ni, lambda_coeff, diffusion_coeff, system_matrix, nz, ix0_owner, ixN_owner, row_start, row_end) &
    !$omp private(ix, iz, iy)
    do iy = row_start, row_end
      do ix = ix0_owner, ixN_owner
        do iz = -nz, nz
          ! eta / scalar equation, implicit half:  lambda - diffusion*ni*(D^2 - k^2)
#:for k in range(-2, 3)
          system_matrix(iz, ix, iy, ${k}$) = lambda_coeff*der(iy, 0, ${k}$) - diffusion_coeff*ni*${helmholtz_op('iy', str(k))}$
#:endfor
        end do
      end do
    end do
    !$omp end target teams distribute parallel do
$:assemble_rhs_tiles()
  end subroutine assemble_compact_helmholtz_system

  SUBROUTINE solve_mean_correction_line(x, lower_bc, lower_ghost_bc, upper_bc, upper_ghost_bc, lambda_coeff, diffusion_coeff)
    !!! THIS OPERATES ON A FULL Y LINE (ASSEMBLED FROM ALL PROCESSES) !!!
    use compact_line_solvers, only: solve_full_line_compact
    IMPLICIT NONE
    complex(C_DOUBLE_COMPLEX), intent(inout) :: x(-1:ny + 1)
    real(C_DOUBLE), intent(in) :: lower_bc(-2:2), lower_ghost_bc(-2:2), upper_bc(-2:2), upper_ghost_bc(-2:2)
    real(C_DOUBLE), intent(in) :: lambda_coeff, diffusion_coeff
    real(C_DOUBLE) :: mat(1:ny + 1, -2:2)
    integer(C_INT) :: iy

    x(-1:0) = 0.0d0
    x(1:ny - 1) = 1.0d0
    x(ny:ny + 1) = 0.0d0
    mat = 0.0d0
    do iy = 1, ny - 1
      mat(iy, -2:2) = lambda_coeff*der(iy, 0, -2:2) - &
                      diffusion_coeff*ni*(der(iy, 2, -2:2) - k2(0, 0)*der(iy, 0, -2:2))
    end do
    call solve_full_line_compact(x, mat, lower_bc, lower_ghost_bc, upper_bc, upper_ghost_bc, &
                                 (0.0d0, 0.0d0), (0.0d0, 0.0d0), (0.0d0, 0.0d0), (0.0d0, 0.0d0), ny)
  END SUBROUTINE solve_mean_correction_line

  SUBROUTINE linsolve(lambda)
    IMPLICIT NONE
    real(C_DOUBLE), intent(in) :: lambda
    integer(C_INT) :: ix, iz, j, y_first, y_last
    real(C_DOUBLE) :: a, b, rk, er, ei, dr, di
    complex(C_DOUBLE_COMPLEX) :: zero_mode_u(-1:ny + 1), zero_mode_w(-1:ny + 1), zero_mode_ucor(-1:ny + 1)
    type(wall_normal_system) :: systems(2)

    ! v and eta are independent: one stacked solve (see solve_wall_normal_systems).
    ! The right-hand sides are read from memrhs, where buildrhs left them; V
    ! receives the solution.
    call roctxPush("linsolve solve_v_eta")
    systems(1)%ctx = compact_component_boundaries(v0bc, v0m1bc, vnbc, vnp1bc, &
                                                  bc0(:, :, 2), bc0(:, :, 4), bcn(:, :, 2), bcn(:, :, 4))
    systems(1)%field => V(:, :, :, 2)
    systems(1)%source => memrhs(:, :, :, 2)
    systems(1)%assemble => assemble_compact_biharmonic_system
    systems(2)%ctx = compact_component_boundaries(eta0bc, eta0m1bc, etanbc, etanp1bc, &
                                                  bc0(:, :, 5), zero_bc, bcn(:, :, 5), zero_bc)
    systems(2)%field => V(:, :, :, 1)
    systems(2)%source => memrhs(:, :, :, 1)
    systems(2)%assemble => assemble_compact_helmholtz_system
    systems(:)%ctx%lambda = lambda
    systems(:)%ctx%diffusion = 1.0d0
    systems(1)%boundary => assemble_selected_compact_component_boundaries
    systems(2)%boundary => assemble_selected_compact_component_boundaries
    call solve_wall_normal_systems(systems)
    call roctxPop("linsolve solve_v_eta")
    call roctxPush("linsolve d_v_dy")
    call apply_dy(V(:, :, :, 2), V(:, :, :, 3))
    call roctxPop("linsolve d_v_dy")

    if (nx0 == 0) then
      call roctxPush("linsolve mean_correction")
      !$omp target update from(V(:, 0, 0, 1))
      call gather_full_y_line(ny, V(:, 0, 0, 1), zero_mode_u)
      zero_mode_w = dcmplx(dimag(zero_mode_u), 0.d0)
      zero_mode_u = dcmplx(dreal(zero_mode_u), 0.d0)
      call solve_mean_correction_line(zero_mode_ucor, eta0bc, eta0m1bc, etanbc, etanp1bc, lambda, 1.0d0)

      fr(1) = yintegr(zero_mode_u, y)
      fr(2) = yintegr(zero_mode_w, y)
      fr(3) = yintegr(zero_mode_ucor, y)
      IF (abs(meanflowx) > 1.0d-7) THEN
        corrpx = (meanflowx - fr(1))/fr(3)
        zero_mode_u = dcmplx(dreal(zero_mode_u) + corrpx*dreal(zero_mode_ucor), dimag(zero_mode_u))
      END IF
      IF (abs(meanflowz) > 1.0d-7) THEN
        corrpz = (meanflowz - fr(2))/fr(3)
        zero_mode_w = dcmplx(dreal(zero_mode_w) + corrpz*dreal(zero_mode_ucor), dimag(zero_mode_w))
      END IF
      call scatter_full_y_line(zero_mode_u, V(:, 0, 0, 1))
      call scatter_full_y_line(zero_mode_w, V(:, 0, 0, 3))
      !$omp target update to(V(:, 0, 0, 1), V(:, 0, 0, 3))
      call roctxPop("linsolve mean_correction")
    end if

    y_first = ny0
    y_last = nyN

    call roctxPush("linsolve recover_u_w")
    ! collapse(3) with y innermost: V is y-fastest, so a wavefront walks contiguous
    ! lines (with collapse(2) each thread walked its own column, 4 KB from the next).
    ! u = (i alfa dv/dy - i beta eta)/k^2, w = (i beta dv/dy + i alfa eta)/k^2,
    ! in real and imaginary parts: as complex expressions amdflang compiled the
    ! two divisions by k2 to __divdc3 calls and the products to full complex
    ! multiplies.
    !$omp target teams distribute parallel do collapse(3) default(none) &
    !$omp shared(ny, y_first, y_last, nz, nx0, nxN) &
    !$omp shared(V, k2, ialfa, ibeta) &
    !$omp private(ix, iz, j, a, b, rk, er, ei, dr, di)
    DO ix = nx0, nxN
      DO iz = -nz, nz
        do j = y_first - 2, y_last + 2
          if (ix == 0 .and. iz == 0) cycle
          a = dimag(ialfa(ix)); b = dimag(ibeta(iz)); rk = 1.0d0/k2(iz, ix)
          er = dreal(V(j, iz, ix, 1)); ei = dimag(V(j, iz, ix, 1))
          dr = dreal(V(j, iz, ix, 3)); di = dimag(V(j, iz, ix, 3))
          V(j, iz, ix, 1) = dcmplx((b*ei - a*di)*rk, (a*dr - b*er)*rk)
          V(j, iz, ix, 3) = dcmplx(-(b*di + a*ei)*rk, (b*dr + a*er)*rk)
        end do
      END DO
    END DO
    call roctxPop("linsolve recover_u_w")
  END SUBROUTINE linsolve

  SUBROUTINE linsolve_scalar(lambda, iPhi)
    IMPLICIT NONE
    integer(C_INT), intent(in) :: iPhi
    real(C_DOUBLE), intent(in) :: lambda
    type(wall_normal_system) :: systems(1)

    call scalar_system(systems(1), lambda, iPhi)
    call solve_wall_normal_systems(systems)
    call correct_scalar_mean(lambda, iPhi)
  END SUBROUTINE linsolve_scalar

  ! All scalars at once: they are independent, so one stacked solve.
  SUBROUTINE linsolve_scalars(lambda)
    IMPLICIT NONE
    real(C_DOUBLE), intent(in) :: lambda
    type(wall_normal_system), allocatable :: systems(:)
    integer(C_INT) :: iPhi

    if (nPhi < 1) return
    allocate (systems(nPhi))
    do iPhi = 1, nPhi
      call scalar_system(systems(iPhi), lambda, iPhi)
    end do
    call solve_wall_normal_systems(systems)
    do iPhi = 1, nPhi
      call correct_scalar_mean(lambda, iPhi)
    end do
  END SUBROUTINE linsolve_scalars

  subroutine scalar_system(sys, lambda, iPhi)
    IMPLICIT NONE
    type(wall_normal_system), intent(out) :: sys
    real(C_DOUBLE), intent(in) :: lambda
    integer(C_INT), intent(in) :: iPhi

    sys%ctx = compact_component_boundaries(phi0bc(:, iPhi), phi0m1bc(:, iPhi), phinbc(:, iPhi), phinp1bc(:, iPhi), &
                                           bc0(:, :, 5 + iPhi), zero_bc, bcn(:, :, 5 + iPhi), zero_bc)
    sys%ctx%lambda = lambda
    sys%ctx%diffusion = pra(iPhi)
    sys%field => V(:, :, :, 3 + iPhi)
    sys%source => memrhs(:, :, :, 2 + iPhi)
    sys%assemble => assemble_compact_helmholtz_system
    sys%boundary => assemble_selected_compact_component_boundaries
  end subroutine scalar_system

  SUBROUTINE correct_scalar_mean(lambda, iPhi)
    IMPLICIT NONE
    integer(C_INT), intent(in) :: iPhi
    real(C_DOUBLE), intent(in) :: lambda
    complex(C_DOUBLE_COMPLEX) :: zero_mode_scalar(-1:ny + 1), zero_mode_tcor(-1:ny + 1)

    if (nx0 == 0) then
      !$omp target update from(V(:, 0, 0, 3 + iPhi))
      call gather_full_y_line(ny, V(:, 0, 0, 3 + iPhi), zero_mode_scalar)
      call solve_mean_correction_line(zero_mode_tcor, phi0bc(:, iPhi), phi0m1bc(:, iPhi), &
                                      phinbc(:, iPhi), phinp1bc(:, iPhi), lambda, pra(iPhi))
      fr(3 + iPhi) = yintegr(zero_mode_scalar, y)
      fr(3 + nPhi + iPhi) = yintegr(zero_mode_tcor, y)
      IF (abs(meantb) > 1.0d-7) THEN
        corrtx(iPhi) = (meantb - fr(3 + iPhi))/fr(3 + nPhi + iPhi)
        zero_mode_scalar = dcmplx(dreal(zero_mode_scalar) + corrtx(iPhi)*dreal(zero_mode_tcor), dimag(zero_mode_scalar))
      END IF
      call scatter_full_y_line(zero_mode_scalar, V(:, 0, 0, 3 + iPhi))
      !$omp target update to(V(:, 0, 0, 3 + iPhi))
    end if
  END SUBROUTINE correct_scalar_mean

  ! The two rVVdx components whose product is nonlinear term m (the pairs
  ! build_products below multiplies).
  SUBROUTINE product_factors(m, a, b)
    integer(C_INT), intent(in) :: m
    integer(C_INT), intent(out) :: a, b
    if (m > 6) then
      a = mod(m - 4, 3) + 1
      b = 3 + (m - 4)/3
    else if (m > 3) then
      a = mod(m - 1, 3) + 1
      b = mod(m, 3) + 1
    else
      a = m
      b = m
    end if
  END SUBROUTINE product_factors

  SUBROUTINE build_products(m, to)
    IMPLICIT NONE
    integer(C_INT), intent(in) :: m, to
    integer(C_INT) :: iPhi, component, first, second, y_first, y_last
    integer(C_INT) :: i, j, k
    real(C_DOUBLE) :: a, b
    y_first = ny0
    y_last = nyN

    if (m > 6) then ! scalar cases 7, ...
      iPhi = (m - 4)/3
      component = mod(m - 4, 3) + 1
      !$omp target teams distribute parallel do collapse(3) default(none) &
      !$omp shared(rVVdx, products, nxd, nzB, y_first, y_last, factor, iPhi, component, to)
      DO i = y_first - 2, y_last + 2
        DO j = 1, nzB
          DO k = 1, 2*nxd
            products(k, j, i, to) = rVVdx(k, j, i, component)*rVVdx(k, j, i, 3 + iPhi)*factor
          END DO
        END DO
      END DO
    else if (m > 3) then !cases 4, 5, 6
      first = mod(m - 1, 3) + 1
      second = mod(m, 3) + 1
      !$omp target teams distribute parallel do collapse(3) default(none) &
      !$omp shared(rVVdx, products, nxd, nzB, y_first, y_last, factor, first, second, m, to) private(a, b)
      DO i = y_first - 2, y_last + 2
        DO j = 1, nzB
          DO k = 1, 2*nxd
            a = rVVdx(k, j, i, first)
            b = rVVdx(k, j, i, second)
            products(k, j, i, to) = a*b*factor
          END DO
        END DO
      END DO
    else ! cases 1, 2, 3
      !$omp target teams distribute parallel do collapse(3) default(none) &
      !$omp shared(rVVdx, products, nxd, nzB, y_first, y_last, factor, m, to) private(a)
      DO i = y_first - 2, y_last + 2
        DO j = 1, nzB
          DO k = 1, 2*nxd
            a = rVVdx(k, j, i, m)
            products(k, j, i, to) = a*a*factor
          END DO
        END DO
      END DO
    end if
  END SUBROUTINE build_products

  !--------------------------------------------------------------!
  !-------------------------- buildRHS --------------------------!
  ! (u,v,w) = (1,2,3)
  ! (uu,vv,ww,uv,vw,uw) = (1,2,3,4,5,6)

  ! The contributions known a priori, for both velocity equations in one
  ! pass: memrhs = ODE(1)/deltat*unknown + viscous term - ODE(3)*oldrhs.
  !
  ! memrhs is where the right-hand side stays: linsolve reads it from there
  ! (V is not overwritten, so there is no copy back into V), and the buildrhs
  ! kernels add the explicit terms to it.
  !
  ! With the fused buildrhs (rhs_fuse) oldrhs is left untouched here:
  ! buildrhs_fused_velocity overwrites it with the new explicit terms without
  ! reading it.  The per-product kernels accumulate into oldrhs instead, so
  ! for them it is zeroed here (and the mean-pressure drive added) as before.
  SUBROUTINE buildrhs_prepare(ODE)
    IMPLICIT NONE
    real(C_DOUBLE), intent(in) :: ODE(1:3)
    integer(C_INT) :: iy, iz, ix, iPhi, y_first, y_last
    complex(C_DOUBLE_COMPLEX) :: tmp, unkn, s0, s2
    logical :: mean
    real(C_DOUBLE) :: c1, o2, o3, kk, a, b
    real(C_DOUBLE) :: ${RHS_DER_NAMES}$
    real(C_DOUBLE) :: ${RHS_LIN_NAMES}$
    y_first = ny0
    y_last = nyN
    if (.not. rhs_fuse_decided) call buildrhs_decide_fusion()
    c1 = ODE(1)/deltat; o2 = ODE(2); o3 = ODE(3)

    ! Two copies of the kernel, with the oldrhs reset compiled in or out: as a
    ! run-time flag inside one kernel the reset cost 6 ms per call even when off.
    if (rhs_fuse) then
$:prepare_velocity_kernel(False)
    else
$:prepare_velocity_kernel(True)
    end if

    !initialize phi
    DO iPhi = 1, nPhi
      !$omp target teams distribute parallel do collapse(3) default(none)  &
      !$omp private(tmp, iz, ix, iy, unkn, s0, s2) &
      !$omp shared(nz, nx0, nxN, ny, y_first, y_last, pra, V, memrhs, ode, c1, oldrhs, iphi, der, k2, ni)
      DO ix = nx0, nxN
        DO iz = -nz, nz
          DO iy = y_first, y_last
            s0 = ${apply_d('V', '3 + iPhi', 0)}$
            s2 = ${apply_d('V', '3 + iPhi', 2)}$
            tmp = ni*(s2 - k2(iz, ix)*s0)
            unkn = s0
            memrhs(iy, iz, ix, 2 + iPhi) = c1*unkn + tmp*pra(iPhi) - ODE(3)*oldrhs(iy, iz, ix, 2 + iPhi)
            oldrhs(iy, iz, ix, 2 + iPhi) = 0.0
          END DO
        END DO
      END DO
    END DO

  END SUBROUTINE buildrhs_prepare

#! ===================================================================
#! buildrhs kernels: every VVdz product is one tiled target region; only the
#! expressions differ.  Each wavefront covers an 8x8 tile of (iz, iy), iz
#! fastest: VVdz is z-fastest while V and oldrhs are y-fastest, so with iy
#! alone fastest every VVdz load hit a different 4 MB-strided line.  A tile
#! reads 8 full z-lines of VVdz and updates 8 full y-lines of V and oldrhs.
#! ===================================================================
#! tile_zy_open / tile_zy_close live in stencil_macros.fypph.
#! Velocity products: expl feeds the d2v equation; rhsu/rhsw, when given,
#! feed the eta equation (and the mean flow for ix = iz = 0).  The kernels add
#! only to oldrhs; buildrhs_finish adds ODE(2) times the sum to memrhs once, which
#! halves the traffic of each of these kernels (both got the same terms).
#:def rhs_velocity_kernel(expl, rhsu=None, rhsw=None)
      !$omp target teams distribute parallel do collapse(5) default(none) &
      !$omp private(rhsu, rhsw, expl, iz, ix, iy, izb, iyb, izi, iyi) &
      !$omp shared(nz, nx0, nxN, ny, y_first, y_last, from, ialfa, ibeta, der, V, oldrhs, izd, ode, k2, VVdz)
$:tile_zy_open()
                ! All VVdz loads before the first store: VVdz points into the shared
                ! workspace, so a store to V or oldrhs would force them to be reloaded.
#:if rhsu is not None
                rhsu = ${rhsu}$
                rhsw = ${rhsw}$
#:endif
                expl = ${expl}$
                $:accum_d2v(None, 'expl')
#:if rhsu is not None
                $:accum_eta_uw(None, 'rhsu', 'rhsw')
#:endif
$:tile_zy_close()
#:enddef
#! Scalar products u*phi, v*phi, w*phi for scalar iPhi.
#:def rhs_scalar_kernel(rhst)
      !$omp target teams distribute parallel do collapse(5) default(none) &
      !$omp private(rhst, iz, ix, iy, izb, iyb, izi, iyi) &
      !$omp shared(nz, nx0, nxN, ny, y_first, y_last, ialfa, ibeta, V, ode, der, oldrhs, iPhi, VVdz, izd, from)
$:tile_zy_open()
                rhst = ${rhst}$
                $:rk_accum(None, 'oldrhs(iy, iz, ix, 2 + iPhi)', 'rhst')
$:tile_zy_close()
#:enddef
#! The explicit terms of every VVdz product, written once.  {D0}, {D1}, {D2}
#! stand for the wall-normal derivatives of the product; expl feeds d2v, and
#! rhsu/rhsw (None: no contribution) feed eta.  The per-product kernels apply
#! them to VVdz, the fused ones to rhs_stash.
#:set VEL_RHS = [dict(expl='ialfa(ix)*ialfa(ix)*{D1}', rhsu='-ialfa(ix)*{D0}', rhsw='0.0'), dict(expl='{D1}*k2(iz, ix)', rhsu=None, rhsw=None), dict(expl='ibeta(iz)*ibeta(iz)*{D1}', rhsu='0.0', rhsw='-ibeta(iz)*{D0}'), dict(expl='ialfa(ix)*{D2}+ialfa(ix)*{D0}*k2(iz, ix)', rhsu='-{D1}', rhsw='0.0'), dict(expl='ibeta(iz)*{D2}+ibeta(iz)*{D0}*k2(iz, ix)', rhsu='0.0', rhsw='-{D1}'), dict(expl='2*ialfa(ix)*ibeta(iz)*{D1}', rhsu='-ibeta(iz)*{D0}', rhsw='-ialfa(ix)*{D0}')]
#:set SCA_RHS = ['-ialfa(ix)*{D0}', '-{D1}', '-ibeta(iz)*{D0}']
#:def rhs_case(c)
#:set e = VEL_RHS[c - 1]
#:set dv = dict(D0=apply_d_vvdz(0, 'from'), D1=apply_d_vvdz(1, 'from'), D2=apply_d_vvdz(2, 'from'))
$:rhs_velocity_kernel(expl=e['expl'].format(**dv), rhsu=None if e['rhsu'] is None else e['rhsu'].format(**dv), rhsw=None if e['rhsw'] is None else e['rhsw'].format(**dv))
#:enddef
#:def rhs_scalar_case(c)
$:rhs_scalar_kernel(SCA_RHS[c - 1].format(D0=apply_d_vvdz(0, 'from'), D1=apply_d_vvdz(1, 'from')))
#:enddef
  SUBROUTINE buildrhs(ODE, component, from)
    IMPLICIT NONE
    real(C_DOUBLE), intent(in) :: ODE(1:3)
    integer(C_INT), intent(in) :: component, from
    integer(C_INT) :: iy, iz, ix, iPhi, y_first, y_last
    integer(C_INT) :: izb, iyb, izi, iyi
    integer(C_INT), parameter :: RHS_TILE = 8
    complex(C_DOUBLE_COMPLEX) :: rhsu, rhsw, rhst, expl
    y_first = ny0
    y_last = nyN

    ! component = the VVdz product held in VVdz(:, :, :, from):
    ! (uu, vv, ww, uv, vw, uw) = (1 .. 6), then (u, v, w)*phi per scalar.
    if (.not. rhs_fuse_decided) call buildrhs_decide_fusion()
    if (rhs_fuse) then
      ! Stash the product; once a group is complete, one fused kernel applies
      ! all of its terms and updates oldrhs once instead of once per product.
      call buildrhs_stash(component, from)
      if (component == 6) call buildrhs_fused_velocity(ODE)
      if (component > 6) then
        if (MODULO(component - 4, 3) == 2) call buildrhs_fused_scalar((component - 4)/3)
      end if
      return
    end if
    SELECT CASE (component)
    CASE (1)
$:rhs_case(1)
    CASE (2)
$:rhs_case(2)
    CASE (3)
$:rhs_case(3)
    CASE (4)
$:rhs_case(4)
    CASE (5)
$:rhs_case(5)
    CASE (6)
$:rhs_case(6)
    CASE DEFAULT
      iPhi = (component - 4)/3
      SELECT CASE (MODULO((component - 4), 3) + 1)
      CASE (1)
$:rhs_scalar_case(1)
      CASE (2)
$:rhs_scalar_case(2)
      CASE (3)
$:rhs_scalar_case(3)
      END SELECT
    END SELECT
  END SUBROUTINE buildrhs

  ! Fusion needs all products of a group in memory before their terms are
  ! applied, which ends the overlap of each product's xz alltoall with the
  ! previous product's buildrhs.  So it is on where the transposes are local
  ! or nothing is overlapped; CHANNEL_BUILDRHS_FUSED overrides either way.
  subroutine buildrhs_decide_fusion()
    use env_options, only: env_flag
    rhs_fuse = fft_transpose_is_local .or. fft_nflds == 1
    call env_flag("CHANNEL_BUILDRHS_FUSED", rhs_fuse)
    if (rhs_fuse) then
      allocate (rhs_stash(ny0 - 2:nyN + 2, -nz:nz, nx0:nxN, 6))
      !$omp target enter data map(alloc: rhs_stash)
    end if
    rhs_fuse_decided = .true.
  end subroutine buildrhs_decide_fusion

  ! Copy the spectral modes buildrhs needs from VVdz (z-fastest) into
  ! rhs_stash (y-fastest), slot 1..6 for the velocity products and 1..3 for a
  ! scalar's.  (iz, iy) tiles as in the kernels it replaces, with the tile
  ! origins moved down by (sz, sy) elements so that every tile row is exactly
  ! one 128-byte line of VVdz and every tile column one line of rhs_stash:
  ! each wavefront then reads 8 whole lines and writes 8 whole lines.  With
  ! the origin at (-nz, y_first - 2) the rows straddled two lines each (3.2 ->
  ! 2.6 ms per call at 1364 x 1365 x 116; only one of the eight z phases is
  ! aligned).  The phases come from the host addresses, which are the device
  ! addresses where the offload runtime maps without copying; elsewhere a
  ! wrong phase only costs the gain.
  subroutine buildrhs_stash(component, from)
    integer(C_INT), intent(in) :: component, from
    integer(C_INT) :: iy, iz, ix, slot, y_first, y_last, izb, iyb, izi, iyi, sz, sy
    integer(C_INT), parameter :: RHS_TILE = 8
    integer(C_INTPTR_T) :: addr
    y_first = ny0
    y_last = nyN
    slot = merge(component, MODULO(component - 4, 3) + 1, component <= 6)
    ! VVdz(k, ...) holds iz = k - 1 - nzd for the negative modes: the tile that
    ! starts at iz = -nz - sz starts at element nzd - nz - sz of its z line.
    addr = transfer(c_loc(VVdz(1, 1, lbound(VVdz, 3), from)), addr)
    sz = int(modulo(addr/16 + int(nzd - nz, C_INTPTR_T), int(RHS_TILE, C_INTPTR_T)), C_INT)
    addr = transfer(c_loc(rhs_stash(y_first - 2, -nz, nx0, slot)), addr)
    sy = int(modulo(addr/16, int(RHS_TILE, C_INTPTR_T)), C_INT)
    !$omp target teams distribute parallel do collapse(5) default(none) &
    !$omp shared(rhs_stash, VVdz, nz, nzd, nx0, nxN, y_first, y_last, slot, from, sz, sy) &
    !$omp private(iz, ix, iy, izb, iyb, izi, iyi)
    DO ix = nx0, nxN
      DO izb = 0, (2*nz + sz)/RHS_TILE
        DO iyb = 0, (y_last - y_first + 4 + sy)/RHS_TILE
          DO iyi = 0, RHS_TILE - 1
            DO izi = 0, RHS_TILE - 1
              iz = -nz - sz + izb*RHS_TILE + izi
              iy = y_first - 2 - sy + iyb*RHS_TILE + iyi
              IF (iz < -nz .OR. iz > nz .OR. iy < y_first - 2 .OR. iy > y_last + 2) CYCLE
              ! izd(iz) + 1 computed rather than looked up: one load less per element
              rhs_stash(iy, iz, ix, slot) = VVdz(merge(iz + 1, nzd + iz + 1, iz >= 0), ix + 1 - nx0, iy, from)
            END DO
          END DO
        END DO
      END DO
    END DO
  end subroutine buildrhs_stash

  ! All six velocity products' terms in one pass, and the end of the substep
  ! for the velocity equations: memrhs += ODE(2)*N and oldrhs = N, with N the
  ! explicit terms (plus the mean-pressure drive in the mean mode).  oldrhs is
  ! written without being read -- buildrhs_prepare has already used the
  ! previous substep's value -- so buildrhs_finish has nothing left to do for
  ! the velocity.  Every array is y-fastest: iy innermost reads and writes
  ! contiguous lines.
  subroutine buildrhs_fused_velocity(ODE)
    real(C_DOUBLE), intent(in) :: ODE(1:3)
    integer(C_INT) :: iy, iz, ix, y_first, y_last
    real(C_DOUBLE) :: kk, a, b, o2, m1r, m1i, m2r, m2i
    real(C_DOUBLE) :: ${RHS_DER_NAMES}$
    real(C_DOUBLE) :: ${RHS_NL_NAMES}$
    y_first = ny0
    y_last = nyN
    o2 = ODE(2)
    !$omp target teams distribute parallel do collapse(3) default(none) &
    !$omp shared(rhs_stash, oldrhs, memrhs, der, ialfa, ibeta, k2, nz, nx0, nxN, y_first, y_last, o2, meanpx, meanpz) &
    !$omp private(iz, ix, iy, kk, a, b, m1r, m1i, m2r, m2i, ${RHS_DER_NAMES}$, ${RHS_NL_NAMES}$)
    DO ix = nx0, nxN
      DO iz = -nz, nz
        DO iy = y_first, y_last
          kk = k2(iz, ix); a = dimag(ialfa(ix)); b = dimag(ibeta(iz))
$:rhs_load_der([0, 1, 2])
$:rhs_nonlinear_real('rhs_stash')
          if (ix == 0 .AND. iz == 0) then
            n1r = n1r + meanpx; n1i = n1i + meanpz
          end if
          ! memrhs is a pointer: load it before the stores.
          m1r = dreal(memrhs(iy, iz, ix, 1)) + o2*n1r; m1i = dimag(memrhs(iy, iz, ix, 1)) + o2*n1i
          m2r = dreal(memrhs(iy, iz, ix, 2)) + o2*n2r; m2i = dimag(memrhs(iy, iz, ix, 2)) + o2*n2i
          memrhs(iy, iz, ix, 1) = dcmplx(m1r, m1i)
          memrhs(iy, iz, ix, 2) = dcmplx(m2r, m2i)
          oldrhs(iy, iz, ix, 1) = dcmplx(n1r, n1i)
          oldrhs(iy, iz, ix, 2) = dcmplx(n2r, n2i)
        END DO
      END DO
    END DO
  end subroutine buildrhs_fused_velocity

  ! The three products of scalar iPhi in one pass.
  subroutine buildrhs_fused_scalar(iPhi)
    integer(C_INT), intent(in) :: iPhi
    integer(C_INT) :: iy, iz, ix, y_first, y_last
    complex(C_DOUBLE_COMPLEX) :: rhst
    y_first = ny0
    y_last = nyN
    !$omp target teams distribute parallel do collapse(3) default(none) &
    !$omp shared(rhs_stash, oldrhs, der, ialfa, ibeta, nz, nx0, nxN, y_first, y_last, iPhi) &
    !$omp private(iz, ix, iy, rhst)
    DO ix = nx0, nxN
      DO iz = -nz, nz
        DO iy = y_first, y_last
          rhst = (0.0d0, 0.0d0)
#:for c in range(1, 4)
          rhst = rhst + ${SCA_RHS[c - 1].format(D0=apply_d('rhs_stash', c, 0), D1=apply_d('rhs_stash', c, 1))}$
#:endfor
          oldrhs(iy, iz, ix, 2 + iPhi) = oldrhs(iy, iz, ix, 2 + iPhi) + rhst
        END DO
      END DO
    END DO
  end subroutine buildrhs_fused_scalar

  ! After all buildrhs calls of a substep: memrhs += ODE(2)*(what buildrhs
  ! added to oldrhs), for the equations whose kernels accumulate into oldrhs
  ! only -- the scalars, and the velocity unless buildrhs_fused_velocity has
  ! done it already.  buildrhs_prepare left oldrhs zero in these components
  ! except the mean pressure drive in the (0,0) mode of component 1, which
  ! memrhs already holds.
  SUBROUTINE buildrhs_finish(ODE)
    IMPLICIT NONE
    real(C_DOUBLE), intent(in) :: ODE(1:3)
    integer(C_INT) :: iy, iz, ix, iPhi, y_first, y_last
    complex(C_DOUBLE_COMPLEX) :: mean_drive
    logical :: velocity
    y_first = ny0
    y_last = nyN
    velocity = .not. rhs_fuse
    if (.not. velocity .and. nPhi == 0) return
    mean_drive = dcmplx(meanpx, meanpz)
    !$omp target teams distribute parallel do collapse(3) default(none) &
    !$omp shared(memrhs, oldrhs, ODE, mean_drive, nz, nx0, nxN, y_first, y_last, nPhi, velocity) private(iy, iz, ix, iPhi)
    DO ix = nx0, nxN
      DO iz = -nz, nz
        DO iy = y_first, y_last
          if (velocity) then
            if (ix == 0 .AND. iz == 0) then
              memrhs(iy, iz, ix, 1) = memrhs(iy, iz, ix, 1) + ODE(2)*(oldrhs(iy, iz, ix, 1) - mean_drive)
            else
              memrhs(iy, iz, ix, 1) = memrhs(iy, iz, ix, 1) + ODE(2)*oldrhs(iy, iz, ix, 1)
            end if
            memrhs(iy, iz, ix, 2) = memrhs(iy, iz, ix, 2) + ODE(2)*oldrhs(iy, iz, ix, 2)
          end if
          DO iPhi = 1, nPhi
            memrhs(iy, iz, ix, 2 + iPhi) = memrhs(iy, iz, ix, 2 + iPhi) + ODE(2)*oldrhs(iy, iz, ix, 2 + iPhi)
          END DO
        END DO
      END DO
    END DO
  END SUBROUTINE buildrhs_finish
end module channel_equations
